{
  "id": "lost112",
  "tools": [
    {
      "name": "search",
      "title": "습득물 찾기",
      "description": "로그인 없이 된다. 경찰청 유실물 통합 조회(옛 LOST112 — 2026년 1월부터 경찰민원24로 옮겨 옛 주소는 열리지 않는다)에서 경찰서·지하철·버스·공항 등에 들어온 습득물을 찾아 물건 이름·분류·습득일·습득 장소·보관 장소·관리번호·링크를 돌려준다. 서울교통공사 등 지하철 유실물도 여기 함께 올라온다. '지하철에 두고 내린 우산 찾아 줘'에 쓴다: 사용자에게 사이트·전화로 알아보라고 하지 말고 이걸로 먼저 찾는다. 고른 물건의 보관 상태·연락처는 lost112_detail로.",
      "tier": "lookup",
      "login": false,
      "status": "검증됨(2026-11-21, 우산 지하철 7일 758건·2호선 20건, 결과 없음 안내)",
      "cards": false,
      "input": {
        "required": [
          "keyword"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 30,
            "description": "물건 이름 한 낱말 (예: 우산, 지갑, 에어팟, 카드지갑). 사이트가 첫 낱말로만 찾으니 색·브랜드는 빼고 넣는다"
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "습득일 시작 YYYY-MM-DD (예: 2026-11-20). 비우면 최근 7일"
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "습득일 끝 YYYY-MM-DD. 비우면 오늘"
          },
          "place_type": {
            "type": "string",
            "enum": [
              "지하철",
              "버스",
              "택시",
              "기차",
              "공항",
              "노상",
              "백화점/매장",
              "음식점(업소포함)",
              "상점",
              "공공기관",
              "영화관",
              "학교",
              "회사",
              "주택",
              "놀이공원",
              "유원지",
              "우체국(통)",
              "기타"
            ],
            "description": "잃어버린 곳 종류. 비우면 전부"
          },
          "storage": {
            "type": "string",
            "maxLength": 30,
            "description": "보관 장소 이름 낱말 (예: 2호선, 을지로입구역, 서초경찰서). 지하철은 '역 이름(호선)'으로 보관된다. 낱말 단위로 찾으니 '역' 한 글자는 안 된다. 비우면 전부"
          },
          "area": {
            "type": "string",
            "maxLength": 20,
            "description": "주운 곳의 시·군·구 (예: 강남구, 성남시). 비우면 전부"
          }
        }
      },
      "output": {
        "total": {
          "type": "string",
          "description": "조건에 맞는 습득물 수"
        },
        "items": {
          "type": "list",
          "description": "습득물 (최근 습득 순, 50개까지)",
          "fields": {
            "name": {
              "type": "string",
              "description": "물건 이름 (괄호 안은 색·메모, '주인연락됨'이면 이미 주인에게 연락됨)"
            },
            "category": {
              "type": "string"
            },
            "found_date": {
              "type": "string",
              "description": "습득일"
            },
            "found_place": {
              "type": "string",
              "description": "습득 장소 (지하철·노상 같은 종류나 차량 번호)"
            },
            "storage": {
              "type": "string",
              "description": "보관 장소 (역·경찰서·지구대)"
            },
            "id": {
              "type": "string",
              "description": "관리번호 (lost112_detail에 넘긴다)"
            },
            "sn": {
              "type": "string",
              "description": "순번 (lost112_detail에 함께 넘긴다)"
            },
            "link": {
              "type": "string"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "found_date",
          "storage",
          "id",
          "link"
        ]
      },
      "examples": [
        {
          "keyword": "우산",
          "place_type": "지하철"
        },
        {
          "keyword": "지갑",
          "area": "강남구"
        }
      ],
      "steps": [
        {
          "open": "https://minwon24.police.go.kr/cvlcpt/cvlcptAply.do?cvlcptId=MW-201"
        },
        {
          "wait": {
            "text": "습득물명",
            "timeoutMs": 20000
          }
        },
        {
          "wait": {
            "items": ".krds-structured-list li.structured-item",
            "timeoutMs": 15000
          }
        },
        {
          "choose": {
            "field": "목록 표시 개수",
            "option": "50개"
          }
        },
        {
          "sleep": 1500
        },
        {
          "type": {
            "field": "^습득물명$",
            "text": "{{keyword}}"
          }
        },
        {
          "type": {
            "field": "^습득일자$",
            "text": "{{from}}"
          },
          "if": "{{from}}"
        },
        {
          "type": {
            "field": "^YYYY-MM-DD$",
            "text": "{{to}}"
          },
          "if": "{{to}}"
        },
        {
          "choose": {
            "field": "^습득장소$",
            "option": "{{place_type}}"
          },
          "if": "{{place_type}}"
        },
        {
          "type": {
            "field": "^보관장소$",
            "text": "{{storage}}"
          },
          "if": "{{storage}}"
        },
        {
          "type": {
            "field": "^지역상세$",
            "text": "{{area}}"
          },
          "if": "{{area}}"
        },
        {
          "press": "Escape"
        },
        {
          "click": {
            "text": "검색하기"
          }
        },
        {
          "sleep": 3000
        },
        {
          "wait": {
            "text": "검색 결과가 없습니다|자세히 보기",
            "timeoutMs": 10000
          }
        },
        {
          "find": {
            "total": "총 ([0-9,]+)개의 항목"
          },
          "as": "count"
        },
        {
          "stop_if": "검색 결과가 없습니다",
          "say": "경찰민원24에 그 기간 '{{keyword}}' 습득물이 아직 없어요. 지하철 유실물은 하루 이틀 뒤에 올라오기도 해요. 기간을 넓히거나 다른 낱말(예: 장우산→우산)로 다시 찾아볼게요."
        },
        {
          "extract": {
            "items": ".krds-structured-list li.structured-item:has(h4)",
            "limit": 50,
            "fields": {
              "name": {
                "css": "h4"
              },
              "category": {
                "match": "분류\\s*([^\\n]+)"
              },
              "found_date": {
                "match": "습득 일자\\s*([0-9.-]+)"
              },
              "found_place": {
                "match": "습득 장소\\s*([^\\n]+)"
              },
              "storage": {
                "match": "보관 장소\\s*([^\\n]+)"
              },
              "id": {
                "css": "button[onclick*=viewDetail]",
                "attr": "onclick",
                "match": "viewDetail\\('([^']+)'"
              },
              "sn": {
                "css": "button[onclick*=viewDetail]",
                "attr": "onclick",
                "match": "viewDetail\\('[^']*',\\s*'([^']*)'"
              }
            }
          },
          "as": "rows"
        },
        {
          "map": {
            "from": "rows",
            "limit": 50,
            "fields": {
              "name": "name",
              "category": "category",
              "found_date": "found_date",
              "found_place": "found_place",
              "storage": "storage",
              "id": "id",
              "sn": "sn",
              "link": "https://minwon24.police.go.kr/cvlcpt/selectFindListDetail.do?cvlcptId=MW-201&pkupCmdtyMngId={{id}}&sortSn={{sn}}"
            }
          },
          "as": "items"
        }
      ],
      "result": {
        "total": "{{count.total}}",
        "items": "{{items}}"
      },
      "next": "사용자가 말한 물건(색·모양·브랜드)과 잃어버린 곳·날짜에 맞는 것 2~5개를 습득일·보관 장소와 함께 보여 줘요. 맞아 보이는 게 있으면 그 id·sn으로 lost112_detail을 불러 보관 상태·연락처·찾는 방법까지 알려 줘요. 없으면 기간을 넓혀 한 번 더 찾고, 그래도 없으면 분실물 신고 초안을 만들어 두자고 해요.",
      "minIntervalSec": 300
    },
    {
      "name": "detail",
      "title": "습득물 보관 상태 보기",
      "description": "로그인 없이 된다. lost112_search로 찾은 습득물 하나의 자세한 정보를 돌려준다: 유실물 상태(보관중·반환 등)·습득 일시·상세 설명(색·특이사항)·접수 장소·보관 장소·보관 장소 연락처. '그 우산 지금 어디 있어, 어떻게 찾아?'에 쓴다. 찾으러 갈 때는 신분증을 챙기라고 함께 말한다.",
      "tier": "lookup",
      "login": false,
      "status": "검증됨(2026-11-21, 석남역 장우산 보관중·연락처, 없는 관리번호 안내)",
      "cards": false,
      "input": {
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]{8,30}$",
            "description": "관리번호 (lost112_search 결과의 id, 예: V0001942L11210004)"
          },
          "sn": {
            "type": "string",
            "pattern": "^[0-9]{1,3}$",
            "default": "1",
            "description": "순번 (lost112_search 결과의 sn, 보통 1)"
          }
        }
      },
      "output": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "유실물 상태 (보관중·반환완료 등)"
        },
        "found_at": {
          "type": "string",
          "description": "습득 일시 (예: 2026-11-21, 03시 경)"
        },
        "found_place": {
          "type": "string",
          "description": "습득 장소 종류 (지하철·노상 등)"
        },
        "detail": {
          "type": "string",
          "description": "상세 내용 (색·특이사항·찾는 방법)"
        },
        "received_at": {
          "type": "string",
          "description": "접수 장소"
        },
        "storage": {
          "type": "string",
          "description": "보관 장소"
        },
        "phone": {
          "type": "string",
          "description": "보관 장소 연락처"
        },
        "link": {
          "type": "string"
        }
      },
      "expect": {
        "filled": [
          "status",
          "storage"
        ]
      },
      "examples": [
        {
          "id": "V0001942L11210004",
          "sn": "1"
        }
      ],
      "steps": [
        {
          "open": "https://minwon24.police.go.kr/cvlcpt/selectFindListDetail.do?cvlcptId=MW-201&pkupCmdtyMngId={{id}}&sortSn={{sn}}"
        },
        {
          "wait": {
            "text": "유실물 상태|찾을 수 없|존재하지 않",
            "timeoutMs": 15000
          }
        },
        {
          "require": "유실물 상태",
          "say": "그 관리번호({{id}})의 습득물 정보가 지금은 없어요. 이미 주인에게 돌려줬거나 기간이 지나 정리됐을 수 있어요. lost112_search로 다시 찾아볼게요."
        },
        {
          "find": {
            "name": "([^\\n]+)\\n+습득 정보",
            "status": "유실물 상태\\s*([^\\n]+)",
            "found_at": "습득 정보\\s*습득일\\s*([^\\n]+)",
            "found_place": "습득 장소\\s*([^\\n]+)",
            "detail": "상세내용\\s*([\\s\\S]{0,190}?)\\n*※",
            "received_at": "접수장소\\s*([^\\n]+)",
            "storage": "관리번호[^\\n]*\\n+보관장소\\s*([^\\n]+)",
            "phone": "보관장소 연락처\\s*([0-9-]{7,})"
          },
          "as": "d"
        }
      ],
      "result": {
        "name": "{{d.name}}",
        "status": "{{d.status}}",
        "found_at": "{{d.found_at}}",
        "found_place": "{{d.found_place}}",
        "detail": "{{d.detail}}",
        "received_at": "{{d.received_at}}",
        "storage": "{{d.storage}}",
        "phone": "{{d.phone}}",
        "link": "https://minwon24.police.go.kr/cvlcpt/selectFindListDetail.do?cvlcptId=MW-201&pkupCmdtyMngId={{id}}&sortSn={{sn}}"
      },
      "next": "보관 상태와 보관 장소·연락처를 말하고, 찾으러 갈 때 신분증을 챙기라고 알려 줘요. 지하철 역 보관물은 1주일쯤 지나면 경찰서로 넘어가니 그 전에 가는 게 좋다고 말해요.",
      "minIntervalSec": 300
    }
  ]
}
