{
  "id": "서비스-id",
  "tools": [
    {
      "name": "search",
      "title": "짧은 제목",
      "description": "언제 쓰는지, 무엇을 돌려주는지, 다음에 무엇을 하면 되는지 (AI가 읽어요).",
      "tier": "lookup",
      "status": "초안",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "검색어 (예: …)"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "output": {
        "items": {
          "type": "list",
          "description": "찾은 것",
          "fields": {
            "name": {
              "type": "string"
            },
            "price": {
              "type": "integer",
              "description": "가격(원)"
            },
            "image": {
              "type": "string",
              "description": "사진 (답에 카드로 보여요)"
            },
            "link": {
              "type": "string",
              "description": "상품 주소"
            }
          }
        }
      },
      "examples": [
        {
          "keyword": "예시"
        }
      ],
      "steps": [
        {
          "open": "https://www.example.co.kr/search?q={{keyword|url}}"
        },
        {
          "wait": {
            "items": "li.item"
          }
        },
        {
          "extract": {
            "items": "li.item",
            "fields": {
              "name": {
                "css": ".name"
              },
              "price": {
                "css": ".price"
              },
              "image": {
                "image": true
              },
              "link": {
                "css": "a",
                "attr": "href"
              }
            }
          },
          "as": "items"
        }
      ],
      "result": {
        "items": "{{items}}"
      }
    }
  ]
}