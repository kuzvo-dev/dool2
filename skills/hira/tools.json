{
  "id": "hira",
  "tools": [
    {
      "name": "nonpay",
      "title": "병원 비급여 진료비 비교",
      "description": "로그인 없이 된다. 건강보험심사평가원 '비급여 진료비용 정보'에서 한 지역(시·도, 시·군·구) 병원들이 신고한 비급여 가격을 병원별로 돌려준다: 병원 이름·종류·도로명 주소·전화·항목 이름·최저~최고 가격·특이사항·신고 기준월·적용 시작일. 최저 가격 싼 순 40곳까지. '○○ 근처 도수치료·MRI·초음파 가격 비교', '체외충격파 싼 데'에 쓴다. 사용자에게 병원마다 전화해 보라고 하지 말고 이걸로 먼저 찾는다. 동(洞)으로는 못 고르니 시·군·구로 찾고, 동네는 near(병원·역 이름이나 도로명 낱말, 예: 정자)로 좁히거나 결과 주소를 보고 고른다. 도수치료는 2026-07-01부터 관리급여로 바뀌었지만 병원 신고 가격은 그대로 나온다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-21, 도수치료 분당구 72곳·강남구 141곳, 체외충격파 화성시 동탄구, MRI 강남구 — 싼 순 40곳·정자 좁히기)",
      "cards": false,
      "input": {
        "required": [
          "item",
          "sido"
        ],
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 40,
            "description": "항목 이름 낱말 (예: 도수치료, 체외충격파, MRI, 초음파, 대상포진, 임플란트, 영양주사). 사이트가 항목 이름·병원 이름에 이 글이 그대로 든 것을 찾으니 낱말 하나로 (예: 'MRI 무릎' 말고 'MRI')"
          },
          "sido": {
            "type": "string",
            "enum": [
              "서울",
              "부산",
              "대구",
              "인천",
              "전남광주",
              "대전",
              "울산",
              "세종",
              "경기",
              "강원",
              "충북",
              "충남",
              "전북",
              "경북",
              "경남",
              "제주"
            ],
            "description": "시·도 (광주·전남은 '전남광주')"
          },
          "sggu": {
            "type": "string",
            "maxLength": 20,
            "description": "시·군·구, 사이트 표기대로 (예: 성남시 분당구, 강남구, 수원시 영통구, 화성시 동탄구). 비우면 시·도 전체"
          },
          "detail": {
            "type": "string",
            "maxLength": 30,
            "description": "찾은 것 가운데 항목 이름에 이 말이 든 것만 (예: MRI면 척추·뇌혈관·근골격, 초음파면 갑상선·유방). 비우면 전부"
          },
          "near": {
            "type": "string",
            "maxLength": 30,
            "description": "병원 이름이나 도로명 주소에 든 말로 좁히기 (예: 정자, 정형외과, 불정로). 동 이름은 주소에 없으니 병원 이름·역 이름 낱말로. 비우면 전부"
          }
        }
      },
      "output": {
        "searched": {
          "type": "string",
          "description": "찾아본 지역과 항목, 전체 병원 수"
        },
        "prices": {
          "type": "list",
          "description": "병원별 가격 (최저 가격 싼 순, 40곳까지)",
          "fields": {
            "hospital": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "description": "의원·병원·종합병원·한의원 등"
            },
            "address": {
              "type": "string",
              "description": "도로명 주소 (번지 없음)"
            },
            "phone": {
              "type": "string"
            },
            "item": {
              "type": "string",
              "description": "항목 이름 (부위·종류 포함)"
            },
            "min_price": {
              "type": "integer",
              "description": "최저 가격(원)"
            },
            "max_price": {
              "type": "integer",
              "description": "최고 가격(원)"
            },
            "note": {
              "type": "string",
              "description": "병원이 적은 특이사항 (몇 분·몇 회 등)"
            },
            "updated": {
              "type": "string",
              "description": "신고 기준월 (예: 202608)"
            },
            "since": {
              "type": "string",
              "description": "이 가격 적용 시작일 (예: 20261029)"
            }
          }
        },
        "link": {
          "type": "string",
          "description": "심평원 비급여 진료비 화면"
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "hospital",
          "address",
          "item",
          "min_price"
        ]
      },
      "examples": [
        {
          "item": "도수치료",
          "sido": "경기",
          "sggu": "성남시 분당구"
        },
        {
          "item": "MRI",
          "sido": "서울",
          "sggu": "강남구",
          "detail": "무릎"
        }
      ],
      "steps": [
        {
          "open": "https://www.hira.or.kr/npay/index.do?pgmid=HIRAA030009000000"
        },
        {
          "wait": {
            "text": "비급여 진료비 항목",
            "timeoutMs": 20000
          }
        },
        {
          "wait": {
            "text": "공개자료 활용 유의사항",
            "timeoutMs": 6000,
            "soft": true
          }
        },
        {
          "click": {
            "text": "위의 사항을 확인하였습니다"
          },
          "optional": true
        },
        {
          "click": {
            "text": "닫기"
          },
          "optional": true
        },
        {
          "sleep": 1000
        },
        {
          "click": {
            "text": "시/도 선택, 시/도 선택"
          }
        },
        {
          "click": {
            "text": "{{sido}}"
          }
        },
        {
          "sleep": 1500
        },
        {
          "click": {
            "text": "시/군/구 선택, 전체"
          },
          "if": "{{sggu}}"
        },
        {
          "sleep": 600,
          "if": "{{sggu}}"
        },
        {
          "click": {
            "text": "{{sggu}}"
          },
          "optional": true,
          "if": "{{sggu}}"
        },
        {
          "find": {
            "got": "{{sggu|re}}"
          },
          "as": "g1",
          "if": "{{sggu}}"
        },
        {
          "press": "PageDown",
          "if": "{{#sggu}}{{^g1.got}}1{{/g1.got}}{{/sggu}}"
        },
        {
          "press": "PageDown",
          "if": "{{#sggu}}{{^g1.got}}1{{/g1.got}}{{/sggu}}"
        },
        {
          "sleep": 400,
          "if": "{{#sggu}}{{^g1.got}}1{{/g1.got}}{{/sggu}}"
        },
        {
          "click": {
            "text": "{{sggu}}"
          },
          "optional": true,
          "if": "{{#sggu}}{{^g1.got}}1{{/g1.got}}{{/sggu}}"
        },
        {
          "find": {
            "got": "{{sggu|re}}"
          },
          "as": "g2",
          "if": "{{#sggu}}{{^g1.got}}1{{/g1.got}}{{/sggu}}"
        },
        {
          "press": "PageDown",
          "if": "{{#sggu}}{{^g2.got}}1{{/g2.got}}{{/sggu}}"
        },
        {
          "click": {
            "text": "{{sggu}}"
          },
          "optional": true,
          "if": "{{#sggu}}{{^g2.got}}1{{/g2.got}}{{/sggu}}"
        },
        {
          "find": {
            "got": "{{sggu|re}}"
          },
          "as": "g3",
          "if": "{{#sggu}}{{^g2.got}}1{{/g2.got}}{{/sggu}}"
        },
        {
          "press": "PageDown",
          "if": "{{#sggu}}{{^g3.got}}1{{/g3.got}}{{/sggu}}"
        },
        {
          "click": {
            "text": "{{sggu}}"
          },
          "optional": true,
          "if": "{{#sggu}}{{^g3.got}}1{{/g3.got}}{{/sggu}}"
        },
        {
          "find": {
            "got": "{{sggu|re}}"
          },
          "as": "g4",
          "if": "{{#sggu}}{{^g3.got}}1{{/g3.got}}{{/sggu}}"
        },
        {
          "require": "{{sggu|re}}",
          "say": "심평원 지역 목록에서 '{{sggu}}'을(를) 찾지 못했어요. 시·군·구를 사이트 표기(예: 성남시 분당구, 강남구, 수원시 영통구)로 다시 찾아볼게요.",
          "if": "{{sggu}}"
        },
        {
          "click": {
            "text": "비급여 진료비용 상세 검색"
          }
        },
        {
          "click": {
            "text": "정렬기준, 정렬기준"
          }
        },
        {
          "click": {
            "text": "최소금액[오름]"
          }
        },
        {
          "click": {
            "text": "목록수 설정, 10개씩 보기"
          }
        },
        {
          "click": {
            "text": "20개씩 보기"
          }
        },
        {
          "type": {
            "field": "결과 내 재검색",
            "text": "{{item}}",
            "submit": true
          }
        },
        {
          "capture": {
            "url": "selectNpayDamtPubList\\.do",
            "pick": "dsNpayDamtPubList",
            "timeoutMs": 15000
          },
          "as": "list"
        },
        {
          "click": {
            "text": "2페이지"
          },
          "optional": true,
          "if": "{{#list.19.yadmNm}}1{{/list.19.yadmNm}}"
        },
        {
          "sleep": 2500,
          "if": "{{#list.19.yadmNm}}1{{/list.19.yadmNm}}"
        },
        {
          "capture": {
            "url": "selectNpayDamtPubList\\.do",
            "pick": "dsNpayDamtPubList",
            "timeoutMs": 15000
          },
          "as": "list",
          "append": true,
          "if": "{{#list.19.yadmNm}}1{{/list.19.yadmNm}}"
        },
        {
          "find": {
            "total": "검색결과 총([0-9,]+)건"
          },
          "as": "count"
        },
        {
          "stop_if": "검색결과 총0건",
          "say": "심평원에 {{sido}}{{#sggu}} {{sggu}}{{/sggu}} '{{item}}' 가격을 신고한 병원이 없어요. 낱말을 줄이거나(예: 'MRI 무릎' 대신 'MRI') 옆 시·군·구로 다시 찾아볼게요."
        },
        {
          "filter": {
            "from": "list",
            "where": "npayCdNm",
            "op": "contains",
            "value": "{{detail}}"
          },
          "as": "part"
        },
        {
          "map": {
            "from": "part",
            "limit": 40,
            "fields": {
              "hospital": "yadmNm",
              "kind": "clCdNm",
              "address": "addr",
              "phone": "yadmGdTelnoTxt",
              "item": "npayCdNm",
              "min_price": "minPrc",
              "max_price": "maxPrc",
              "note": "rmkTxt",
              "updated": "pubYm",
              "since": "adtFrDd",
              "where": "{{yadmNm}} {{addr}}"
            }
          },
          "as": "rows"
        },
        {
          "filter": {
            "from": "rows",
            "where": "where",
            "op": "contains",
            "value": "{{near}}"
          },
          "as": "prices"
        }
      ],
      "result": {
        "searched": "{{sido}}{{#sggu}} {{sggu}}{{/sggu}} '{{item}}' 병원 {{count.total}}곳",
        "prices": "{{prices}}",
        "link": "https://www.hira.or.kr/npay/index.do?pgmid=HIRAA030009000000"
      },
      "next": "찾아본 지역·병원 수(searched)를 먼저 말하고, 싼 곳 3~5곳을 병원 이름·가격·주소로 보여 줘요. 사용자가 말한 동네(동·역)가 있으면 주소·병원 이름으로 가까운 곳을 골라 먼저 말해요. 같은 항목도 시간·횟수·부위에 따라 값이 다르니 item·note가 다르면 함께 말해요. 병원에 전화해 보라고 권하지 않아요.",
      "minIntervalSec": 300
    }
  ]
}
