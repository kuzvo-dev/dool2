{
  "id": "naver-flight",
  "tools": [
    {
      "name": "search",
      "title": "국내선 항공권 비교",
      "description": "로그인 없이 된다. 네이버 항공권에서 국내선 편도를 여러 항공사(대한항공·아시아나·제주항공·진에어·티웨이·이스타·에어부산·파라타 등) 한 번에 찾아 편마다 항공사·출발/도착 시각·소요 시간·좌석 등급·가격을 돌려준다. 기본은 가격 낮은 순. '제일 싼 비행기', '저녁 비행기 있어?'에 항공사 사이트를 하나씩 열기 전에 먼저 쓴다. 왕복이면 가는 날·오는 날을 따로 두 번 부른다. 예매는 그 항공사 도구나 사이트에서 승인받고 한다.",
      "tier": "lookup",
      "login": false,
      "status": "검증됨(2026-11-26, 김포→제주 12/15 가격 낮은 순·출발 시간대·최대 가격, 화면 읽기)",
      "input": {
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "출발 공항 코드 (김포 GMP, 인천 ICN, 제주 CJU, 김해 PUS, 대구 TAE, 광주 KWJ, 청주 CJJ, 여수 RSU, 울산 USN, 포항 KPO, 양양 YNY, 사천 HIN, 무안 MWX, 군산 KUV, 원주 WJU)"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "도착 공항 코드 (위와 같음)"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "가는 날 YYYY-MM-DD (예: 2026-12-15)"
          },
          "after": {
            "type": "string",
            "format": "time",
            "description": "이 시각 이후 출발만 (예: 18:00)"
          },
          "before": {
            "type": "string",
            "format": "time",
            "description": "이 시각 이전 출발만 (예: 12:00)"
          },
          "max_price": {
            "type": "integer",
            "minimum": 0,
            "description": "이 가격(원) 이하만"
          },
          "by_time": {
            "type": "boolean",
            "default": false,
            "description": "true면 출발 빠른 순 (기본은 가격 낮은 순)"
          }
        },
        "required": [
          "from",
          "to",
          "date"
        ]
      },
      "output": {
        "flights": {
          "type": "list",
          "description": "항공편 (같은 편이 좌석 등급마다 따로 나와요)",
          "fields": {
            "airline": {
              "type": "string"
            },
            "shared": {
              "type": "string",
              "description": "공동운항이면 실제 운항사"
            },
            "depart": {
              "type": "string",
              "description": "출발 시각"
            },
            "arrive": {
              "type": "string",
              "description": "도착 시각"
            },
            "duration": {
              "type": "string"
            },
            "fare": {
              "type": "string",
              "description": "좌석 등급 (특가석·할인석·일반석·비즈니스석)"
            },
            "price": {
              "type": "string",
              "description": "편도 가격 (어른 1명, 결제 수단 할인 전)"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "airline",
          "depart",
          "price"
        ]
      },
      "examples": [
        {
          "from": "GMP",
          "to": "CJU",
          "date": "2026-12-15"
        },
        {
          "from": "GMP",
          "to": "PUS",
          "date": "2026-12-18",
          "after": "18:00",
          "by_time": true
        }
      ],
      "steps": [
        {
          "open": "https://flight.naver.com/flights/domestic/{{from}}-{{to}}-{{date|digits}}?adult=1&fareType=YC"
        },
        {
          "wait": {
            "text": "출발시각 빠른 순|항공편이 없|검색 결과가 없",
            "timeoutMs": 20000
          }
        },
        {
          "stop_if": "항공편이 없|검색 결과가 없",
          "say": "{{date}} {{from}}→{{to}} 국내선 항공편이 없어요. 날짜나 공항(예: 김포 대신 인천)을 바꿔 다시 찾아요."
        },
        {
          "click": {
            "text": "출발시각 빠른 순"
          },
          "optional": true,
          "if": "{{^by_time}}1{{/by_time}}"
        },
        {
          "sleep": 800,
          "if": "{{^by_time}}1{{/by_time}}"
        },
        {
          "click": {
            "text": "가격 낮은 순"
          },
          "optional": true,
          "if": "{{^by_time}}1{{/by_time}}"
        },
        {
          "sleep": 1500
        },
        {
          "extract": {
            "items": "[class*=\"domestic_Flight\"]",
            "limit": 80,
            "fields": {
              "airline": {
                "line": 0
              },
              "shared": {
                "match": "([가-힣A-Za-z]+) 공동운항"
              },
              "depart": {
                "match": "(\\d{2}:\\d{2})[A-Z]{3}"
              },
              "arrive": {
                "match": "\\d{2}:\\d{2}[A-Z]{3}\\s*(\\d{2}:\\d{2})[A-Z]{3}"
              },
              "duration": {
                "match": "(\\d{2}시간 \\d{2}분)"
              },
              "fare": {
                "match": "([가-힣]+석)편도"
              },
              "price": {
                "match": "편도\\s*([\\d,]+원)"
              }
            }
          },
          "as": "all"
        },
        {
          "filter": {
            "from": "all",
            "where": "depart",
            "op": "gte",
            "value": "{{after}}"
          },
          "as": "f1"
        },
        {
          "filter": {
            "from": "f1",
            "where": "depart",
            "op": "lte",
            "value": "{{before}}"
          },
          "as": "f2"
        },
        {
          "filter": {
            "from": "f2",
            "where": "price",
            "op": "lte",
            "value": "{{max_price}}"
          },
          "as": "flights"
        }
      ],
      "result": {
        "flights": "{{flights}}"
      },
      "next": "결론 한 줄: 가장 싼 편(항공사·출발 시각·좌석 등급·가격). show_list로 3~6편(title=출발→도착 시각·항공사, sub=좌석 등급·소요 시간, value=가격)을 붙여요. 가격은 어른 1명 편도, 결제 수단 할인 전이에요. 왕복이면 오는 날도 이 도구로 따로 찾아 합계를 말해요. 예매를 원하면 그 항공사로 예매를 준비한다고 제안해요(결제는 승인 뒤).",
      "minIntervalSec": 300,
      "cards": false
    }
  ]
}
