{
  "id": "shilla-dfs",
  "tools": [
    {
      "name": "search",
      "title": "면세품 찾기",
      "description": "로그인 없이 된다. 신라인터넷면세점에서 검색어로 면세품을 찾아 브랜드·이름·면세가(달러)·원화 환산가·별점·리뷰 수·관심 수·품절 여부·상품 번호·링크를 돌려준다. 검색 화면을 열고 sort 글자를 눌러 정렬한 뒤 화면 목록(40개)을 읽는다. '$50 이하 향수'처럼 달러 조건은 max_usd로 거른다. 회원 할인율·적립금 적용가는 로그인해야 보인다. 주문하려면 shilla_dfs_prepare_order에 product_no를 넘긴다(출국 정보가 필요).",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-18, 향수·핸드크림 검색, 정렬 누르기·달러 거르기, 화면 목록 읽기)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "찾을 상품·브랜드 (예: 향수, 조 말론, 립스틱, 위스키)",
            "maxLength": 40
          },
          "sort": {
            "type": "string",
            "enum": [
              "구매많은순",
              "신상품순",
              "낮은가격순",
              "높은가격순",
              "할인율순",
              "리뷰많은순"
            ],
            "default": "구매많은순",
            "description": "정렬 (기본 구매많은순)"
          },
          "max_usd": {
            "type": "number",
            "minimum": 0,
            "description": "최대 면세가(달러) (예: $50 이하면 50). 없으면 비워 둔다"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40,
            "default": 10,
            "description": "몇 개까지 (기본 10)"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "output": {
        "products": {
          "type": "list",
          "description": "상품",
          "fields": {
            "name": {
              "type": "string"
            },
            "brand": {
              "type": "string"
            },
            "product_no": {
              "type": "string",
              "description": "shilla_dfs_prepare_order에 넘길 상품 번호"
            },
            "price_usd": {
              "type": "string",
              "description": "면세가 (달러, $206처럼)"
            },
            "price_krw": {
              "type": "string",
              "description": "원화 환산가 (275,010원처럼, 오늘 환율)"
            },
            "rating": {
              "type": "string",
              "description": "별점 (5점 만점)"
            },
            "reviews": {
              "type": "string",
              "description": "리뷰 수"
            },
            "likes": {
              "type": "string",
              "description": "관심 수 (12K처럼)"
            },
            "sold_out": {
              "type": "string",
              "description": "품절이면 '일시품절'"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "brand",
          "product_no",
          "price_usd",
          "link"
        ]
      },
      "examples": [
        {
          "keyword": "향수"
        },
        {
          "keyword": "핸드크림",
          "sort": "낮은가격순",
          "max_usd": 30,
          "limit": 5
        }
      ],
      "steps": [
        {
          "open": "https://www.shilladfs.com/estore/kr/ko/search?text={{keyword|url}}"
        },
        {
          "wait": {
            "items": "li:has(a.pro_link)",
            "timeoutMs": 15000
          }
        },
        {
          "click": {
            "text": "{{sort}}"
          },
          "optional": true
        },
        {
          "sleep": 2500
        },
        {
          "wait": {
            "items": "li:has(a.pro_link)",
            "timeoutMs": 10000
          }
        },
        {
          "extract": {
            "items": "li:has(a.pro_link)",
            "limit": 40,
            "fields": {
              "name": {
                "css": ".info_name"
              },
              "brand": {
                "css": ".info_brand"
              },
              "product_no": {
                "css": "a.pro_link",
                "attr": "href",
                "match": "/p/(\\d+)"
              },
              "price_usd": {
                "css": ".p_sum > :nth-child(1)"
              },
              "price_krw": {
                "css": ".p_sum > :nth-child(2)"
              },
              "rating": {
                "css": ".plike",
                "match": "^([\\d.]+)"
              },
              "reviews": {
                "css": ".plike",
                "match": "\\(([\\d,]+)\\)"
              },
              "likes": {
                "css": ".pwish"
              },
              "sold_out": {
                "match": "(일시품절|품절)"
              },
              "image": {
                "image": true
              }
            }
          },
          "as": "found",
          "min": 1
        },
        {
          "filter": {
            "from": "found",
            "where": "price_usd",
            "op": "lte",
            "value": "{{max_usd}}"
          },
          "as": "cheap"
        },
        {
          "map": {
            "from": "cheap",
            "limit": "{{limit}}",
            "fields": {
              "name": "name",
              "image": "image",
              "brand": "brand",
              "product_no": "product_no",
              "price_usd": "price_usd",
              "price_krw": "price_krw",
              "rating": "rating",
              "reviews": "reviews",
              "likes": "likes",
              "sold_out": "sold_out",
              "link": "https://www.shilladfs.com/estore/kr/ko/p/{{product_no}}"
            }
          },
          "as": "products"
        }
      ],
      "result": {
        "products": "{{products}}"
      },
      "next": "값이 맞는 것 3~5개를 브랜드·이름·면세가(달러와 원)·별점으로 짧게 보여 주고 품절은 빼요. 면세품은 출국 정보(출국일·출국 공항·항공편)가 있어야 살 수 있어요. 주문하려면 shilla_dfs_prepare_order에 product_no를 넘겨요.",
      "minIntervalSec": 600
    },
    {
      "name": "orders",
      "title": "주문 내역·인도장 확인",
      "description": "로그인(연결)해야 된다. 신라인터넷면세점 주문 내역 화면을 열어 최근 주문의 주문일·상품·결제 금액(달러·원)·출국일·출국 공항·인도장 위치·지금 상태(결제 완료·인도 대기·인도 완료·취소)를 읽어 정리한다. '어디 인도장에서 받아?'에 먼저 쓴다. 적립금을 물으면 같은 마이페이지의 적립금·사라질 적립금(날짜)도 읽는다.",
      "tier": "찾아보기",
      "login": true,
      "status": "초안",
      "input": {
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3,
            "description": "최근 주문 몇 건까지 (기본 3)"
          },
          "with_points": {
            "type": "boolean",
            "default": false,
            "description": "적립금도 함께 볼지 (예: '사라지는 적립금 있어?'면 true)"
          }
        },
        "required": []
      },
      "output": {},
      "examples": [
        {
          "count": 3
        }
      ],
      "steps": [
        {
          "open": "https://www.shilladfs.com/estore/kr/ko/my-account/orders"
        },
        {
          "wait": {
            "text": "로그인이 필요한 서비스|아이디 저장|주문일|인도장",
            "timeoutMs": 10000
          },
          "optional": true
        },
        {
          "stop_if": "로그인이 필요한 서비스|아이디 저장|비밀번호 찾기",
          "say": "신라인터넷면세점에 로그인해야 주문 내역을 볼 수 있어요.",
          "login": true
        },
        {
          "handoff_to_agent": "신라인터넷면세점 주문 내역 화면이에요. 최근 주문 {{count}}건까지 주문일·상품·결제 금액(달러·원)·출국일·출국 공항·인도장 위치·지금 상태를 읽어 짧게 정리해요. 인도장은 공항·터미널과 층·위치까지 화면에 적힌 그대로 알려 줘요. with_points가 {{with_points}}이면(true) 마이페이지의 적립금·이번 달 사라질 적립금과 날짜도 읽어요. 주문 취소·출국 정보 바꾸기 버튼은 누르지 않아요. 주문 번호·여권 번호·전화번호는 사용자에게 다시 말하지 않아요."
        }
      ],
      "result": {}
    },
    {
      "name": "prepare_order",
      "title": "출국 전 주문 준비",
      "description": "고른 면세품 화면을 열어 개수를 맞추고 주문 직전까지 간다. 바로구매·출국 정보(출국일·출국 공항·항공편) 입력·결제 화면은 열어 둔 탭에서 브라우저 도구로 이어서 하고, 결제·주문 확정은 사용자 승인(browser_request_approval)을 받아야만 한다. 주문은 로그인과 여권 정보 등록이 필요하다: 연결 전이면 그때 connect_ask('shilla-dfs'). 출국일·공항·항공편을 모르면 먼저 사용자에게 묻는다. 면세 한도·주문 마감 시간은 화면 안내 그대로 알린다.",
      "tier": "돈 내기",
      "status": "초안",
      "input": {
        "properties": {
          "product_no": {
            "type": "string",
            "description": "shilla_dfs_search가 준 상품 번호 (예: 5040720)",
            "pattern": "^\\d{3,12}$"
          },
          "product": {
            "type": "string",
            "description": "상품 이름 (사용자에게 보일 말)",
            "maxLength": 80
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "description": "개수 (기본 1)"
          },
          "departure": {
            "type": "string",
            "format": "date",
            "description": "출국일 YYYY-MM-DD (예: 2026-11-27)"
          },
          "airport": {
            "type": "string",
            "description": "출국 공항·터미널 (예: 인천공항 제1터미널, 김포공항)",
            "maxLength": 30
          },
          "flight": {
            "type": "string",
            "description": "항공편 (예: KE703). 모르면 비워 둔다",
            "maxLength": 10
          }
        },
        "required": [
          "product_no",
          "departure",
          "airport"
        ]
      },
      "output": {},
      "examples": [
        {
          "product_no": "5040720",
          "product": "딥티크 오 드 퍼퓸 플레르 드 뽀 75ml",
          "quantity": 1,
          "departure": "2026-11-27",
          "airport": "인천공항 제1터미널"
        }
      ],
      "steps": [
        {
          "open": "https://www.shilladfs.com/estore/kr/ko/p/{{product_no}}"
        },
        {
          "require": "바로구매|장바구니|재입고알림|일시품절",
          "say": "이 상품 화면이 열리지 않았어요. 판매가 끝났거나 번호가 바뀌었을 수 있어요. shilla_dfs_search로 다시 찾아볼게요.",
          "timeoutMs": 12000
        },
        {
          "stop_if": "재입고알림|일시품절",
          "say": "{{product}}은(는) 지금 품절이에요. 비슷한 상품을 shilla_dfs_search로 찾아볼 수 있어요."
        },
        {
          "handoff_to_agent": "{{product}} 상품 화면이에요. 개수를 {{quantity}}개로 맞춰 '바로구매'를 눌러요. 로그인 화면이 나오면 연결 전이면 connect_ask('shilla-dfs'), 연결했는데 풀렸으면 browser_handoff. 출국 정보는 출국일 {{departure}}, 출국 공항 {{airport}}, 항공편 {{flight}}로 맞춰요(항공편이 비어 있으면 사용자에게 물어요). 여권 정보가 없다고 나오면 사용자에게 직접 등록해 달라고 browser_handoff. 결제 화면에서 멈추고 상품·개수·면세가(달러·원)·할인·적립금·최종 결제 금액·출국일·공항·인도장 안내만 정리해 browser_request_approval로 승인을 받아요. 승인 전에는 결제 버튼을 누르지 않아요."
        }
      ],
      "result": {}
    }
  ]
}
