              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "examples": [
        {
          "keyword": "아쿠아리움"
        }
      ],
      "steps": [
        {
          "open": "https://nol.yanolja.com/discovery/list/search/PRODUCT_CATEGORY_LEISURE?q={{keyword|url}}"
        },
        {
          "wait": {
            "text": "개 검색결과|검색 결과가 없|검색결과가 없",
            "timeoutMs": 20000
          }
        },
        {
          "stop_if": "검색 결과가 없|검색결과가 없",
          "say": "'{{keyword}}'(으)로는 레저·입장권 상품이 안 나와요. 다른 말로 찾아볼까요?"
        },
        {
          "wait": {
            "items": "a[data-card-type][href*='/leisure/']",
            "timeoutMs": 10000
          }
        },
        {
          "extract": {
            "items": "a[data-card-type][href*='/leisure/']",
            "limit": 30,
            "fields": {
              "name": {
                "css": "span.line-clamp-2"
              },
              "product_id": {
                "attr": "href",
                "match": "/leisure/(\\d+)"
              },
              "kind": {
                "css": "span.text-text-neutral-sub"
              },
              "area": {
                "css": "[aria-label^='위치 ']",
                "attr": "aria-label",
                "match": "위치 (.+)"
              },
              "rating": {
                "css": "[aria-label^='리뷰 정보']",
                "attr": "aria-label",
                "match": "평점 ([\\d.]+)"
              },
              "reviews": {
                "css": "[aria-label^='리뷰 정보']",
                "attr": "aria-label",
                "match": "후기 ([\\d,]+)"
              },
              "price": {
                "css": "[aria-label^='판매가']",
                "attr": "aria-label",
                "match": "([\\d,]+)"
              },
              "original_price": {
                "css": "[aria-label^='정상가']",
                "attr": "aria-label",
                "match": "([\\d,]+)"
              },
              "link": {
                "attr": "href"
              },
              "image": {
                "image": true
              }
            }
          },
          "as": "found"
        },
        {
          "filter": {
            "from": "found",
            "where": "price",
            "op": "lte",
            "value": "{{max_price}}"
          },
          "as": "items"
        }
      ],
      "result": {
        "items": "{{items}}"
      },
      "next": "가격·평점으로 2~3개를 보여 주고 고르게 해요. 사려면 yanolja_prepare_ticket에 product_id·날짜·수량을 넘겨요.",
      "minIntervalSec": 300
    },
    {
      "name": "prepare_booking",
      "title": "숙소 예약 준비",
      "description": "yanolja_search로 고른 숙소의 객실 선택 화면을 그 날짜·인원으로 열어, 객실별 가격·무료 취소 기한·남은 객실을 읽고 사용자가 고른 객실의 '예약하기'까지 데려간다. 결제·예약 확정은 사용자 승인(browser_request_approval)을 받아야만 한다. 예약 단계에서 로그인이 필요하면 connect_ask('yanolja').",
      "tier": "돈 내기",
      "login": false,
      "status": "초안",
      "input": {
        "properties": {
          "stay_id": {
            "type": "string",
            "description": "yanolja_search가 준 숙소 id (예: 3013417)",
            "pattern": "^\\d{1,12}$"
          },
          "stay": {
            "type": "string",
            "description": "숙소 이름 (사용자에게 보일 말)",
            "maxLength": 60
          },
          "checkin": {
            "type": "string",
            "format": "date",
            "description": "체크인 YYYY-MM-DD"
          },
          "checkout": {
            "type": "string",
            "format": "date",
            "description": "체크아웃 YYYY-MM-DD"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 2,
            "description": "성인 인원"
          },
          "room_wish": {
            "type": "string",
            "description": "원하는 객실 조건 (예: 오션뷰, 조식 포함, 트윈, 무료 취소). 없으면 비워 둔다",
            "maxLength": 80
          }
        },
        "required": [
          "stay_id",
          "checkin",
          "checkout"
        ]
      },
      "output": {},
      "examples": [
        {
          "stay_id": "3013417",
          "stay": "강릉 세인트존스호텔",
          "checkin": "2026-11-28",
          "checkout": "2026-11-29",
          "adults": 2,
          "room_wish": "오션뷰"
        }
      ],
      "steps": [
        {
          "open": "https://nol.yanolja.com/stay/domestic/{{stay_id|digits}}?adultCount={{adults}}&checkInDate={{checkin}}&checkOutDate={{checkout}}"
        },
        {
          "wait": {
            "text": "객실 선택|예약하기|예약마감|선택한 날짜에",
            "timeoutMs": 15000
          }
        },
        {
          "handoff_to_agent": "NOL(야놀자) {{stay}} {{checkin}}~{{checkout}} 성인 {{adults}}명의 '객실 선택' 화면이에요. 객실마다 이름·기준/최대 인원·숙박 요금(회원가)·무료취소 기한·'N개 남음'·조식 여부를 읽어 사용자 바람({{room_wish}})에 맞는 것 2~3개를 보여 주고 고르게 해요. 고르면 그 요금 줄의 '예약하기'를 누르고, 예약 화면에서 숙소·객실·날짜·인원·총 금액·취소 규정을 정리해 browser_request_approval로 승인받은 뒤에만 결제로 넘어가요. '예약마감'이면 다른 날짜나 yanolja_search로 다른 숙소를 권해요. 로그인 화면이 나오면 connect_ask('yanolja')(연결한 적이 있으면 두리가 그때 쓴 방법으로 알아서 다시 로그인해요)."
        }
      ],
      "result": {}
    },
    {
      "name": "prepare_ticket",
      "title": "레저·입장권 구매 준비",
      "description": "yanolja_leisure_search로 고른 레저·입장권 상품 화면을 열어 권종·날짜·수량을 고르는 데까지 데려간다. 결제는 사용자 승인(browser_request_approval)을 받아야만 한다. 구매 단계에서 로그인이 필요하면 connect_ask('yanolja').",
