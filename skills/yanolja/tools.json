              "type": "string"
            },
            "product_id": {
              "type": "string",
              "description": "yanolja_prepare_ticket에 넘길 상품 id"
            },
            "kind": {
              "type": "string",
              "description": "분류 (테마파크·워터파크 …)"
            },
            "area": {
              "type": "string"
            },
            "rating": {
