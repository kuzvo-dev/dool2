{
  "id": "yanolja",
  "tools": [
    {
      "name": "search",
      "title": "국내 숙소 찾기",
      "description": "로그인 없이 된다. 지역·숙소 이름·테마(예: 강릉, 가평 풀빌라)로 NOL(야놀자) 국내 숙소를 그 체크인·체크아웃으로 찾아 숙소마다 이름·숙소 id·종류·위치 안내·평점·후기 수·1박 최저가(회원가, 성인 2명 기준)·정가·입실 시각·광고 표시·링크를 돌려준다. 화면에 처음 뜨는 15곳 안팎이다. max_price를 주면 그 값 이하만 남긴다. 인원 맞춘 객실·무료 취소·남은 객실은 yanolja_prepare_booking이 연 숙소 화면에서 본다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-17, 강릉·해운대 날짜별 숙소 목록·1박 가격 거르기. 인원은 성인 2 고정)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "지역·숙소 이름·테마 (예: 강릉, 가평 풀빌라, 해운대 호텔)",
            "maxLength": 40
          },
          "checkin": {
            "type": "string",
            "format": "date",
            "description": "체크인 날짜 YYYY-MM-DD (예: 2026-11-28)"
          },
          "checkout": {
            "type": "string",
            "format": "date",
            "description": "체크아웃 날짜 YYYY-MM-DD (예: 2026-11-29)"
          },
          "max_price": {
            "type": "integer",
            "minimum": 0,
            "description": "1박 최대 가격(원). 15만 원 이하면 150000. 없으면 비워 둔다"
          }
        },
        "required": [
          "keyword",
          "checkin",
          "checkout"
        ]
      },
      "output": {
        "stays": {
          "type": "list",
          "description": "숙소",
          "fields": {
            "name": {
              "type": "string"
            },
            "stay_id": {
              "type": "string",
              "description": "yanolja_prepare_booking에 넘길 숙소 id"
            },
            "kind": {
              "type": "string",
              "description": "숙소 종류 (호텔·펜션·모텔 …)"
            },
            "area": {
              "type": "string",
              "description": "위치 안내"
            },
            "rating": {
              "type": "number"
            },
            "reviews": {
              "type": "integer"
            },
            "price": {
              "type": "integer",
              "description": "1박 최저가(원, 회원가)"
            },
            "original_price": {
              "type": "integer",
              "description": "정가(원), 할인 없으면 비어 있음"
            },
            "checkin_time": {
              "type": "string",
              "description": "숙박 입실 시각"
            },
            "ad": {
              "type": "string",
              "description": "'광고'면 광고 숙소"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "examples": [
        {
          "keyword": "강릉",
          "checkin": "2026-11-28",
          "checkout": "2026-11-29"
        }
      ],
      "steps": [
        {
          "open": "https://nol.yanolja.com/discovery/list/search/PRODUCT_CATEGORY_KOREA_ACCOMMODATION?q={{keyword|url}}&checkInDate={{checkin}}&checkOutDate={{checkout}}"
        },
        {
          "wait": {
            "text": "개 검색결과|검색 결과가 없|검색결과가 없",
            "timeoutMs": 15000
          }
        },
        {
          "stop_if": "검색 결과가 없|검색결과가 없",
          "say": "'{{keyword}}'(으)로는 숙소가 안 나와요. 지역 이름(예: 강릉, 해운대)으로 다시 찾아볼까요?"
        },
        {
          "wait": {
            "items": "a[data-card-type][href*='/stay/']",
            "timeoutMs": 10000
          }
        },
        {
          "extract": {
            "items": "a[data-card-type][href*='/stay/']",
            "limit": 30,
            "fields": {
              "name": {
                "css": "span.line-clamp-2"
              },
              "stay_id": {
                "attr": "href",
                "match": "/stay/[a-z]+/(\\d+)"
              },
              "kind": {
                "css": "span.text-text-neutral-sub"
              },
              "area": {
                "css": "[aria-label^='위치 ']",
                "attr": "aria-label",
                "match": "위치 (.+)"
              },
              "rating": {
                "css": "[aria-label^='리뷰 정보']",
                "attr": "aria-label",
                "match": "평점 ([\\d.]+)"
              },
              "reviews": {
                "css": "[aria-label^='리뷰 정보']",
                "attr": "aria-label",
                "match": "후기 ([\\d,]+)"
              },
              "price": {
                "css": "[aria-label^='판매가']",
                "attr": "aria-label",
                "match": "([\\d,]+)"
              },
              "original_price": {
                "css": "[aria-label^='정상가']",
                "attr": "aria-label",
                "match": "([\\d,]+)"
              },
              "checkin_time": {
                "match": "숙박 (\\d{1,2}:\\d{2})"
              },
              "ad": {
                "match": "\\n(광고)\\n"
              },
              "link": {
                "attr": "href"
              },
              "image": {
                "image": true
              }
            }
          },
          "as": "found"
        },
        {
          "filter": {
            "from": "found",
            "where": "price",
            "op": "lte",
            "value": "{{max_price}}"
          },
          "as": "stays"
        }
      ],
      "result": {
        "stays": "{{stays}}"
      },
      "next": "평점·후기 수·가격을 견줘 2~3곳을 짧게 보여 주고(광고 숙소는 광고라고 알려요) 고르게 해요. 객실·무료 취소·남은 방을 보거나 예약하려면 yanolja_prepare_booking에 stay_id·날짜·인원을 넘겨요.",
      "minIntervalSec": 300
    },
    {
      "name": "leisure_search",
      "title": "레저·입장권 찾기",
      "description": "로그인 없이 된다. 키워드(예: 아쿠아리움, 워터파크, 서울 스파)로 NOL(야놀자) 국내 레저·입장권 상품을 찾아 이름·상품 id·분류·지역·평점·후기 수·최저가·정가·링크를 돌려준다. 날짜별 남은 수량과 권종은 상품 화면에서 본다: 사려면 yanolja_prepare_ticket.",
      "tier": "찾아보기",
      "login": false,
      "status": "초안",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "찾을 레저·입장권 (예: 아쿠아리움, 캐리비안베이, 제주 요트)",
            "maxLength": 40
          },
          "max_price": {
            "type": "integer",
