{
  "id": "gohyang",
  "tools": [
    {
      "name": "gifts",
      "title": "답례품 찾기",
      "description": "로그인 없이 된다. 고향사랑e음 답례품몰에서 지역(시·도·시·군·구 이름)이나 답례품 이름으로 찾아, 받을 포인트(max_points) 안의 답례품 이름·지역·포인트·품절·마을기업 여부·사진·링크를 돌려준다. 기부액의 30%가 포인트라 10만 원이면 max_points=30000. '답례품 골라 줘'에는 뉴스만 보지 말고 후보 지역마다 이걸로 실제 목록을 본 뒤 고른다. 사는 곳(내 정보의 주소)의 시·군·구에는 기부할 수 없으니 빼고 찾는다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-20, 전북·제주 감귤, 3만 P 거르기, 목록 48개 고르기, 화면이 받은 응답 읽기)",
      "input": {
        "required": [
          "keyword"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 30,
            "description": "지역이나 답례품 이름 (예: \"전북\", \"보령\", \"제주 감귤\", \"한우\")"
          },
          "max_points": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 3000000,
            "default": 30000,
            "description": "받을 포인트 (기부액의 30%: 10만 원 → 30000). 이보다 비싼 답례품은 뺀다"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "default": 12,
            "description": "몇 개까지 (기본 12)"
          }
        }
      },
      "output": {
        "gifts": {
          "type": "list",
          "description": "답례품 (지자체가 정한 대표 답례품이 위에, 나머지는 무작위)",
          "fields": {
            "name": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "description": "기부할 지자체 (예: 전북특별자치도 완주군)"
            },
            "points": {
              "type": "integer",
              "description": "답례품 포인트 (P)"
            },
            "sold_out": {
              "type": "string",
              "description": "품절이면 값이 있다"
            },
            "village": {
              "type": "string",
              "description": "Y면 마을기업 답례품"
            },
            "link": {
              "type": "string",
              "description": "답례품 화면 — 답에 ([이름](이 주소))로 붙인다"
            },
            "image": {
              "type": "string",
              "description": "사진"
            }
          }
        },
        "total": {
          "type": "integer",
          "description": "이 검색어로 나오는 답례품 전체 수 (포인트 거르기 전)"
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "region",
          "points",
          "link"
        ]
      },
      "examples": [
        {
          "keyword": "전북"
        },
        {
          "keyword": "제주 감귤",
          "max_points": 30000,
          "limit": 6
        }
      ],
      "steps": [
        {
          "open": "https://ilovegohyang.go.kr/goods/index-main.html?keyword={{keyword|url}}"
        },
        {
          "wait": {
            "text": "검색결과\\s*[\\d,]+\\s*건",
            "timeoutMs": 15000
          }
        },
        {
          "stop_if": "검색결과\\s*0\\s*건",
          "say": "이 말로 나온 답례품이 없어요. 시·도 이름(예: 전북, 경북)이나 품목(예: 한우, 쌀)으로 다시 찾아요."
        },
        {
          "choose": {
            "field": "목록 표시",
            "option": "48개"
          }
        },
        {
          "capture": {
            "url": "/api/item/list/list-new\\?.*itemsPerPage=48",
            "timeoutMs": 12000
          },
          "as": "data"
        },
        {
          "map": {
            "from": "data.content",
            "fields": {
              "name": "itemName",
              "region": "locgovNm",
              "points": "salePrice",
              "sold_out": "itemSoldOutFlag",
              "village": "communityBusinessYn",
              "link": "https://ilovegohyang.go.kr/items/details.html?code={{itemUserCode}}",
              "image": "https://ilovegohyang.go.kr{{itemImage}}"
            },
            "limit": 48
          },
          "as": "all"
        },
        {
          "filter": {
            "from": "all",
            "where": "points",
            "op": "lte",
            "value": "{{max_points}}"
          },
          "as": "fit"
        },
        {
          "map": {
            "from": "fit",
            "fields": {
              "name": "name",
              "region": "region",
              "points": "points",
              "sold_out": "sold_out",
              "village": "village",
              "link": "link",
              "image": "image"
            },
            "limit": "{{limit}}"
          },
          "as": "gifts"
        }
      ],
      "result": {
        "gifts": "{{gifts}}",
        "total": "{{data.totalElements}}"
      },
      "next": "후보 지역마다 2~3개씩 골라 이름·포인트를 표처럼 보여 주고 줄마다 ([답례품](link))를 붙여요. 품절(sold_out)은 빼요. 기부하려면 로그인한 고향사랑e음에서 그 지역 기부 → 답례품 신청이고, 결제라 승인을 받아요.",
      "minIntervalSec": 60
    }
  ]
}
