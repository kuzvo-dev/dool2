{
  "id": "coupang",
  "tools": [
    {
      "name": "search",
      "title": "상품 찾기",
      "description": "쿠팡에서 상품을 찾아 비교에 쓸 칸을 돌려준다(이름·상품 id·지금 가격·할인 전 가격·평점·리뷰 수·배송 배지(로켓배송 등)·도착 예정·배송비·광고 여부·링크). 로그인 없이 된다. 싼 것부터 보려면 sort를 salePriceAsc로. 가격 거르기는 없어서 '3만 원 이하'면 price로 골라 준다. 광고(ad)는 따로 알려 준다. 사려면 coupang_prepare_order에 product_id·item_id·vendor_item_id를 넘긴다.",
      "tier": "찾아보기",
      "status": "검증됨(2026-11-18, 사용자 Chrome에서 두부·김치 검색 20개)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "찾을 상품 (예: 무선 청소기, 물티슈 캡형)",
            "maxLength": 60
          },
          "sort": {
            "type": "string",
            "enum": [
              "scoreDesc",
              "salePriceAsc",
              "salePriceDesc",
              "saleCountDesc",
              "latestAsc"
            ],
            "default": "scoreDesc",
            "description": "정렬: scoreDesc = 쿠팡 랭킹순(기본), salePriceAsc = 낮은 가격순, salePriceDesc = 높은 가격순, saleCountDesc = 판매량순, latestAsc = 최신순"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "output": {
        "products": {
          "type": "list",
          "description": "상품",
          "fields": {
            "name": {
              "type": "string"
            },
            "product_id": {
              "type": "string",
              "description": "주문 준비에 넘길 상품 id"
            },
            "item_id": {
              "type": "string"
            },
            "vendor_item_id": {
              "type": "string"
            },
            "price": {
              "type": "integer",
              "description": "지금 가격(원)"
            },
            "original": {
              "type": "integer",
              "description": "할인 전 가격(원)"
            },
            "rating": {
              "type": "number",
              "description": "평점(5점 만점)"
            },
            "reviews": {
              "type": "integer"
            },
            "badges": {
              "type": "strings",
              "description": "배송 배지 (ROCKET = 로켓배송, ROCKET_MERCHANT = 판매자로켓, TOMORROW = 내일도착, ROCKET_FRESH = 로켓프레시, COUPANG_GLOBAL = 로켓직구 등)"
            },
            "arrival": {
              "type": "string",
              "description": "도착 예정 (예: 내일(수) 도착)"
            },
            "shipping": {
              "type": "string",
              "description": "무료배송 또는 배송비"
            },
            "ad": {
              "type": "string",
              "description": "광고면 '광고'"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "상품 사진 (카드에 넣는다)"
            }
          }
        }
      },
      "examples": [
        {
          "keyword": "무선 청소기",
          "sort": "salePriceAsc"
        },
        {
          "keyword": "물티슈 캡형"
        }
      ],
      "steps": [
        {
          "open": "https://www.coupang.com/"
        },
        {
          "wait": {
            "text": "로켓배송|Access Denied|사용권한이 없",
            "timeoutMs": 12000
          }
        },
        {
          "stop_if": "Access Denied|사용권한이 없|사용권한이 제한",
          "say": "쿠팡이 지금 이 브라우저의 접속을 막고 있어요. 잠시 뒤에 다시 하거나, 열어 둔 탭에서 직접 확인해 주세요.",
          "blocked": true
        },
        {
          "sleep": 1200
        },
        {
          "open": "https://www.coupang.com/np/search?q={{keyword|url}}&sorter={{sort}}&listSize=36"
        },
        {
          "wait": {
            "text": "에 대한 검색결과|검색결과가 없|Access Denied|사용권한이 없",
            "timeoutMs": 12000
          }
        },
        {
          "stop_if": "Access Denied|사용권한이 없|사용권한이 제한",
          "say": "쿠팡이 지금 이 브라우저의 접속을 막고 있어요. 잠시 뒤에 다시 하거나, 열어 둔 탭에서 직접 확인해 주세요.",
          "blocked": true
        },
        {
          "stop_if": "검색결과가 없",
          "say": "쿠팡에서 '{{keyword}}' 상품을 찾지 못했어요. 더 짧은 이름이나 다른 말로 찾아볼까요?"
        },
        {
          "extract": {
            "items": "#product-list > li:has(a[href*='/vp/products/'])",
            "limit": 20,
            "fields": {
              "name": {
                "css": "[class*='productName']"
              },
              "product_id": {
                "css": "a[href*='/vp/products/']",
                "attr": "href",
                "match": "/vp/products/(\\d+)"
              },
              "item_id": {
                "css": "a[href*='/vp/products/']",
                "attr": "href",
                "match": "itemId=(\\d+)"
              },
              "vendor_item_id": {
                "css": "a[href*='/vp/products/']",
                "attr": "href",
                "match": "vendorItemId=(\\d+)"
              },
              "price": {
                "css": "[class*='PriceArea']",
                "match": "(?:^|\\n)(\\d[\\d,]*)원(?![\\s\\S]*\\n\\d[\\d,]*원)"
              },
              "original": {
                "css": "[class*='PriceArea'] del"
              },
              "rating": {
                "css": "[class*='ProductRating'] [aria-label]",
                "attr": "aria-label"
              },
              "reviews": {
                "css": "[class*='ProductRating']",
                "match": "\\(([\\d,]+)\\)"
              },
              "badges": {
                "css": "img[data-badge-id]",
                "attr": "data-badge-id",
                "list": true
              },
              "arrival": {
                "match": "([^\\n]*도착[^\\n]*)"
              },
              "shipping": {
                "match": "(무료배송|배송비[^\\n]*)"
              },
              "ad": {
                "match": "\\n(광고)(?:\\n|$)"
              },
              "img_path": {
                "css": "img[src*='coupangcdn.com/thumbnails/remote/']",
                "attr": "src",
                "match": "/thumbnails/remote/[^/]+(/[^?#]+)"
              }
            }
          },
          "as": "rows"
        },
        {
          "map": {
            "from": "rows",
            "fields": {
              "name": "name",
              "image": "{{#img_path}}https://thumbnail.coupangcdn.com/thumbnails/remote/230x230ex{{img_path}}{{/img_path}}",
              "product_id": "product_id",
              "item_id": "item_id",
              "vendor_item_id": "vendor_item_id",
              "price": "price",
              "original": "original",
              "rating": "rating",
              "reviews": "reviews",
              "badges": "badges",
              "arrival": "arrival",
              "shipping": "shipping",
              "ad": "ad",
              "link": "https://www.coupang.com/vp/products/{{product_id}}?itemId={{item_id}}&vendorItemId={{vendor_item_id}}"
            }
          },
          "as": "products"
        }
      ],
      "result": {
        "products": "{{products}}"
      },
      "next": "가격·평점·리뷰 수·로켓배송 여부·도착 예정을 견줘 2~4개를 골라 show_cards로 사진(image)·가격·주소(link)를 카드로 붙이고, 글로는 고른 이유·차이만 짧게 말해요(광고는 광고라고 밝혀요). 사려면 coupang_prepare_order.",
      "minIntervalSec": 300
    },
    {
      "name": "orders",
      "title": "주문 찾기·배송 조회",
      "description": "쿠팡 주문 내역에서 산 물건을 찾거나 최근 주문을 본다. 로그인해야 한다. item(상품 이름 낱말)을 주면 쿠팡 주문 검색으로 최근 6개월 → 올해 → 지난해 … 6년 전까지 차례로 찾아 처음 나온 기간의 주문을 한 번에 돌려준다 (기간·쪽을 넘기며 다시 부르지 않는다). 해를 알면 year('작년에 산'=지난해), 합계처럼 모든 해가 필요하면 all=true. 낱말은 짧게 하나(예: '베개 커버'보다 '베개'), 이름에 그대로 있어야 찾는다. 결과: 주문일·찾은 상품·수량·1개 금액·배송 상태·도착일·반품 가능 일수·주문 번호·상품 id·링크, 찾아본 기간(searched), 더 있는 해(more_years), 못 찾았을 때 다음 길(tip). 배송 상태: FINAL_DELIVERY 배송완료, DELIVERING 배송중, DEPARTURE 출고, CANCELED 취소. 다시 주문은 상품 id로 coupang_prepare_order, 반품은 coupang_return.",
      "tier": "찾아보기",
      "login": true,
      "status": "검증됨(2026-11-19, 사용자 Chrome에서 최근 6개월·연도별 검색 7곳·찾은 상품만·쪽 정보 확인, 여러 해 이어 찾기는 엔진 시험)",
      "input": {
        "properties": {
          "item": {
            "type": "string",
            "description": "찾을 상품 이름 낱말 (예: 베개, 키보드, 생수). 띄어 쓴 두 낱말은 둘 다 든 것만. 없으면 최근 주문",
            "maxLength": 40
          },
          "year": {
            "type": "integer",
            "description": "그 해 주문만 (예: 2025). 없으면 item이 있을 때 최근 6개월부터 6년 전까지 차례로",
            "minimum": 2010,
            "maximum": 2030
          },
          "all": {
            "type": "boolean",
            "description": "true면 찾은 기간에서 멈추지 않고 올해~6년 전을 다 모은다 (해마다 첫 5건, '산 돈 다 합쳐' 같은 때). item과 함께"
          },
          "page": {
            "type": "integer",
            "description": "쪽 번호 (0부터, 한 쪽 5건). more_years에 있는 해를 year와 함께 더 볼 때",
            "minimum": 0,
            "maximum": 30,
            "default": 0
          }
        },
        "required": []
      },
      "output": {
        "orders": {
          "type": "list",
          "description": "찾은 주문 (최근 것부터)",
          "fields": {
            "ordered": {
              "type": "string",
              "description": "주문일"
            },
            "items": {
              "type": "strings",
              "description": "찾은 상품 이름(옵션 포함). 검색이면 검색어에 맞은 상품만"
            },
            "prices": {
              "type": "strings",
              "description": "상품별 결제 금액(원, 1개당)"
            },
            "quantities": {
              "type": "strings",
              "description": "상품별 수량"
            },
            "status": {
              "type": "strings",
              "description": "배송 묶음별 상태 코드 (상품 수와 다를 수 있어요)"
            },
            "arrival": {
              "type": "strings",
              "description": "배송 묶음별 도착 메시지 (예: 11/13(금) 도착)"
            },
            "delivered": {
              "type": "string",
              "description": "도착한 날 (첫 배송 묶음)"
            },
            "return_days": {
              "type": "number",
              "description": "도착 뒤 반품·교환할 수 있는 날 수 (보통 30)"
            },
            "order_id": {
              "type": "string"
            },
            "product_ids": {
              "type": "strings"
            },
            "item_ids": {
              "type": "strings"
            },
            "vendor_item_ids": {
              "type": "strings"
            },
            "image": {
              "type": "string",
              "description": "첫 상품 사진 (카드에 넣어요)"
            },
            "link": {
              "type": "string",
              "description": "주문 상세 주소"
            }
          }
        },
        "searched": {
          "type": "string",
          "description": "찾아본 기간 (예: 최근 6개월, 2026년, 2025년)"
        },
        "has_more": {
          "type": "boolean",
          "description": "첫 기간에 다음 쪽이 더 있다 (page를 올려 더 봐요)"
        },
        "more_years": {
          "type": "string",
          "description": "5건이 넘어 다음 쪽이 더 있는 해 (year·page로 더 봐요)"
        },
        "tip": {
          "type": "string",
          "description": "못 찾았을 때 다음에 할 일"
        }
      },
      "examples": [
        {},
        {
          "item": "에어프라이"
        },
        {
          "year": 2025
        }
      ],
      "steps": [
        {
          "open": "https://mc.coupang.com/ssr/desktop/order/list?{{#item}}isSearch=true&keyword={{item|url}}&{{/item}}{{#year}}requestYear={{year}}&{{/year}}{{^year}}{{#all}}requestYear={{today|yyyy}}&{{/all}}{{/year}}pageIndex={{page}}"
        },
        {
          "wait": {
            "text": "주문목록|아이디\\(이메일\\)|비밀번호 찾기|로그인 상태 유지",
            "timeoutMs": 8000,
            "soft": true
          }
        },
        {
          "stop_if": "아이디\\(이메일\\)|비밀번호 찾기|로그인 상태 유지",
          "say": "쿠팡 주문을 보려면 먼저 쿠팡을 연결(로그인)해야 해요.",
          "login": true
        },
        {
          "embedded": {
            "css": "script#__NEXT_DATA__",
            "pick": "props.pageProps.domains.desktopOrder.orderPagination"
          },
          "as": "p0"
        },
        {
          "embedded": {
            "css": "script#__NEXT_DATA__",
            "pick": "props.pageProps.domains.desktopOrder.orderList"
          },
          "as": "found"
        },
        {
          "open": "https://mc.coupang.com/ssr/desktop/order/list?isSearch=true&keyword={{item|url}}&requestYear={{today|yyyy}}&pageIndex=0",
          "if": "{{#item}}{{^year}}{{^p0.hasPrev}}{{^all}}{{^found.0}}1{{/found.0}}{{/all}}{{/p0.hasPrev}}{{/year}}{{/item}}"
        },
        {
          "embedded": {
            "css": "script#__NEXT_DATA__",
