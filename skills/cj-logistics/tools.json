{
  "id": "cj-logistics",
  "tools": [
    {
      "name": "track",
      "title": "택배 조회",
      "description": "CJ대한통운 운송장 번호로 배송 상황을 조회한다. 상품 이름, 지금 상태(예: 배송출발, 배달완료)와 시각·장소, 지나온 단계 목록을 돌려준다. 받는 분·보내는 분 이름은 사이트가 가린 그대로(김*)다. 등록 전이면 그렇다고 알려 준다. 같은 번호는 30분 안에 다시 묻지 않는다.",
      "tier": "lookup",
      "status": "검증됨(2026-11-17, 등록 전 번호 안내까지. 배송 중 번호는 아직)",
      "input": {
        "properties": {
          "invoice": {
            "type": "string",
            "description": "운송장 번호. 숫자만 10자리나 12자리 (예: 572023456781). '-'는 빼고 넣는다",
            "pattern": "^\\d{10}(\\d{2})?$"
          }
        },
        "required": [
          "invoice"
        ]
      },
      "output": {
        "item": {
          "type": "string",
          "description": "상품"
        },
        "status": {
          "type": "string",
          "description": "지금 상태"
        },
        "updated": {
          "type": "string",
          "description": "마지막 처리 시각"
        },
        "place": {
          "type": "string",
          "description": "마지막 처리 장소"
        },
        "events": {
          "type": "list",
          "description": "지나온 단계",
          "fields": {
            "step": {
              "type": "string"
            },
            "time": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "place": {
              "type": "string"
            }
          }
        }
      },
      "examples": [
        {
          "invoice": "572023456781"
        }
      ],
      "steps": [
        {
          "open": "https://www.cjlogistics.com/ko/tool/parcel/tracking?gnbInvcNo={{invoice|digits}}"
        },
        {
          "wait": {
            "text": "운송장이 등록되지 않았거나|상품상태",
            "timeoutMs": 10000
          }
        },
        {
          "stop_if": "운송장이 등록되지 않았거나",
          "say": "운송장 {{invoice}}은(는) 아직 등록되지 않았거나 보내는 분이 상품을 준비 중이에요. 번호가 맞는지 보고, 맞으면 보낸 곳(쇼핑몰)에 물어보면 돼요."
        },
        {
          "extract": {
            "items": "tbody:has(#itemNm) tr",
            "fields": {
              "item": {
                "css": "#itemNm"
              },
              "qty": {
                "css": "#qty"
              }
            }
          },
          "as": "info"
        },
        {
          "extract": {
            "items": "#statusDetail tr:has(td:nth-child(4))",
            "limit": 60,
            "fields": {
              "step": {
                "css": "td:nth-child(1)"
              },
              "time": {
                "css": "td:nth-child(2)"
              },
              "status": {
                "css": "td:nth-child(3)"
              },
              "place": {
                "css": "td:nth-child(4)"
              }
            }
          },
          "as": "events"
        }
      ],
      "result": {
        "item": "{{info.0.item}}",
        "status": "{{events.-1.step}} — {{events.-1.status}}",
        "updated": "{{events.-1.time}}",
        "place": "{{events.-1.place}}",
        "events": "{{events}}"
      },
      "next": "배달 전이면 사용자에게 지금 상태와 마지막 장소를 짧게 알려 줘요. 계속 지켜봐 달라고 하면 goal_create로 30분 넘는 간격의 확인을 만들어요.",
      "minIntervalSec": 1800
    }
  ]
}
