{
  "id": "parcel",
  "tools": [
    {
      "name": "track",
      "title": "택배 조회(택배사 몰라도)",
      "description": "택배 운송장 번호로 배송 상황을 볼 때 먼저 쓴다(택배사를 모르거나 CJ대한통운에 없다고 나왔을 때도). 번호 자릿수에 맞는 택배사만(13자리 우체국, 10~11자리 로젠, 10·12자리 CJ대한통운·한진, 12자리 롯데) 차례로 한 번에 찾아, 찾은 택배사와 처리 기록 줄(시각이 있는 줄만, 각 줄의 칸 목록: 날짜·시간·장소·상태 등)을 돌려준다. 다섯 곳 모두 없으면 그렇다고 알려 준다. 받는 분 이름은 사이트가 가린 그대로다.",
      "tier": "lookup",
      "status": "검증됨(2026-11-26, 다섯 곳 모두 등록 전 번호 안내까지. 배송 중 번호는 아직)",
      "cards": false,
      "input": {
        "properties": {
          "invoice": {
            "type": "string",
            "description": "운송장 번호. 숫자 10~13자리 (예: 572023456781). '-'와 띄어쓰기는 빼고 넣는다",
            "pattern": "^\\d{10,13}$"
          }
        },
        "required": [
          "invoice"
        ]
      },
      "output": {
        "carrier": {
          "type": "string",
          "description": "찾은 택배사"
        },
        "events": {
          "type": "list",
          "description": "조회 표의 줄(위에서부터)",
          "fields": {
            "cells": {
              "type": "strings",
              "description": "한 줄의 칸들"
            }
          }
        }
      },
      "examples": [
        {
          "invoice": "572023456781"
        }
      ],
      "steps": [
        {
          "open": "https://service.epost.go.kr/trace.RetrieveDomRigiTraceList.comm?sid1={{invoice|digits}}",
          "if": "{{invoice|digits}}",
          "ifMatch": "^\\d{13}$"
        },
        {
          "wait": {
            "text": "배달정보를 찾지 못했습니다|처리현황",
            "timeoutMs": 10000,
            "soft": true
          },
          "if": "{{invoice|digits}}",
          "ifMatch": "^\\d{13}$"
        },
        {
          "extract": {
            "items": "tr:has(td:nth-child(4)):not(:has(td:nth-child(5)))",
            "limit": 40,
            "fields": {
              "cells": {
                "css": "td",
                "list": true
              }
            }
          },
          "as": "rows_epost",
          "min": 0,
          "if": "{{invoice|digits}}",
          "ifMatch": "^\\d{13}$"
        },
        {
          "filter": {
            "from": "rows_epost",
            "where": "cells",
            "op": "contains",
            "value": ":"
          },
          "as": "events",
          "if": "{{#rows_epost.0}}1{{/rows_epost.0}}"
        },
        {
          "find": {
            "name": "(우체국)"
          },
          "as": "carrier",
          "if": "{{#events.0}}1{{/events.0}}"
        },
        {
          "open": "https://www.ilogen.com/web/personal/trace/{{invoice|digits}}",
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{10,11}$"
        },
        {
          "wait": {
            "text": "배송자료를 조회할 수 없습니다|배송상태|배송조회",
            "timeoutMs": 10000,
            "soft": true
          },
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{10,11}$"
        },
        {
          "extract": {
            "items": "tr:has(td:nth-child(3))",
            "limit": 40,
            "fields": {
              "cells": {
                "css": "td",
                "list": true
              }
            }
          },
          "as": "rows_logen",
          "min": 0,
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{10,11}$"
        },
        {
          "filter": {
            "from": "rows_logen",
            "where": "cells",
            "op": "contains",
            "value": ":"
          },
          "as": "events",
          "if": "{{#rows_logen.0}}1{{/rows_logen.0}}"
        },
        {
          "find": {
            "name": "(로젠)"
          },
          "as": "carrier",
          "if": "{{#events.0}}{{^carrier.name}}1{{/carrier.name}}{{/events.0}}"
        },
        {
          "open": "https://www.cjlogistics.com/ko/tool/parcel/tracking?gnbInvcNo={{invoice|digits}}",
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "wait": {
            "text": "운송장이 등록되지 않았거나|상품상태",
            "timeoutMs": 10000,
            "soft": true
          },
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "extract": {
            "items": "#statusDetail tr:has(td:nth-child(4))",
            "limit": 40,
            "fields": {
              "cells": {
                "css": "td",
                "list": true
              }
            }
          },
          "as": "rows_cj",
          "min": 0,
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "filter": {
            "from": "rows_cj",
            "where": "cells",
            "op": "contains",
            "value": ":"
          },
          "as": "events",
          "if": "{{#rows_cj.0}}1{{/rows_cj.0}}"
        },
        {
          "find": {
            "name": "(CJ대한통운)"
          },
          "as": "carrier",
          "if": "{{#events.0}}{{^carrier.name}}1{{/carrier.name}}{{/events.0}}"
        },
        {
          "open": "https://www.lotteglogis.com/home/reservation/tracking/linkView?InvNo={{invoice|digits}}",
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{12}$"
        },
        {
          "wait": {
            "text": "처리현황",
            "timeoutMs": 10000,
            "soft": true
          },
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{12}$"
        },
        {
          "extract": {
            "items": "tr:has(td:nth-child(3))",
            "limit": 40,
            "fields": {
              "cells": {
                "css": "td",
                "list": true
              }
            }
          },
          "as": "rows_lotte",
          "min": 0,
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^\\d{12}$"
        },
        {
          "filter": {
            "from": "rows_lotte",
            "where": "cells",
            "op": "contains",
            "value": ":"
          },
          "as": "events",
          "if": "{{#rows_lotte.0}}1{{/rows_lotte.0}}"
        },
        {
          "find": {
            "name": "(롯데)"
          },
          "as": "carrier",
          "if": "{{#events.0}}{{^carrier.name}}1{{/carrier.name}}{{/events.0}}"
        },
        {
          "open": "https://www.hanjin.com/kor/CMS/DeliveryMgr/WaybillResult.do?mCode=MN038&schLang=KR&wblnumText2={{invoice|digits}}",
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "wait": {
            "text": "배송조회",
            "timeoutMs": 10000,
            "soft": true
          },
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "extract": {
            "items": "tr:has(td:nth-child(3))",
            "limit": 40,
            "fields": {
              "cells": {
                "css": "td",
                "list": true
              }
            }
          },
          "as": "rows_hanjin",
          "min": 0,
          "if": "{{^events.0}}{{invoice|digits}}{{/events.0}}",
          "ifMatch": "^(\\d{10}|\\d{12})$"
        },
        {
          "filter": {
            "from": "rows_hanjin",
            "where": "cells",
            "op": "contains",
            "value": ":"
          },
          "as": "events",
          "if": "{{#rows_hanjin.0}}1{{/rows_hanjin.0}}"
        },
        {
          "find": {
            "name": "(한진)"
          },
          "as": "carrier",
          "if": "{{#events.0}}{{^carrier.name}}1{{/carrier.name}}{{/events.0}}"
        },
        {
          "stop_if": "배송|조회|택배",
          "if": "{{^events.0}}1{{/events.0}}",
          "say": "운송장 {{invoice}}은(는) CJ대한통운·우체국·한진·롯데·로젠 어디에도 아직 등록되지 않았어요. 보낸 곳이 상품을 준비 중이거나 다른 택배사(경동·대신·일양·편의점택배 등)일 수 있어요. 메일이 연결돼 있으면 이 번호나 '운송장'으로 메일을 찾아 택배사를 확인하고, 아니면 사용자에게 택배사를 물어요."
        }
      ],
      "result": {
        "carrier": "{{carrier.name}}",
        "events": "{{events}}"
      },
      "next": "가장 최근 줄(보통 표의 마지막 줄, 우체국·롯데는 마지막, 한진·로젠은 위나 아래일 수 있음)의 상태·장소·시각을 2문장으로 알려 줘요. 계속 지켜봐 달라고 하면 goal_create로 30분 넘는 간격의 확인을 만들어요.",
      "minIntervalSec": 600
    }
  ]
}
