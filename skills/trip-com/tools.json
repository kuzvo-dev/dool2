{
  "id": "trip-com",
  "tools": [
    {
      "name": "hotel_search",
      "title": "해외 호텔 찾기",
      "description": "로그인 없이 된다. 인기 도시(city 목록에서 고름)의 호텔을 체크인·체크아웃·인원·객실 수로 찾아 호텔마다 이름·호텔 id·위치 안내·평점(10점 만점)·리뷰 수·추천 객실·1박 요금·총금액(세금·서비스비 포함)·무료 취소 표시·남은 객실·링크를 돌려준다. 첫 화면 10곳 안팎이다. max_price를 주면 1박 요금이 그 값 이하만 남긴다. 목록에 없는 도시는 브라우저 도구로 검색칸에서 찾는다. 예약하려면 trip_com_prepare_hotel에 hotel_id를 넘긴다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-17, 오사카·도쿄 날짜·인원별 호텔·1박/총금액·무료 취소)",
      "input": {
        "properties": {
          "city": {
            "type": "string",
            "description": "도시 (목록에서 그대로 고름, 뒤의 수가 도시 번호)",
            "enum": [
              "도쿄 228",
              "오사카 219",
              "교토 734",
              "후쿠오카 248",
              "삿포로 641",
              "서울 274",
              "부산 253",
              "제주 737",
              "타이베이 617",
              "홍콩 58",
              "싱가포르 73",
              "방콕 359",
              "파타야 622",
              "푸켓 725",
              "코사무이 1229",
              "다낭 1356",
              "하노이 286",
              "호치민 301",
              "발리 723"
            ]
          },
          "checkin": {
            "type": "string",
            "format": "date",
            "description": "체크인 YYYY-MM-DD (예: 2026-12-10)"
          },
          "checkout": {
            "type": "string",
            "format": "date",
            "description": "체크아웃 YYYY-MM-DD (예: 2026-12-12)"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 2,
            "description": "성인 인원 (기본 2)"
          },
          "rooms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "description": "객실 수 (기본 1)"
          },
          "max_price": {
            "type": "integer",
            "minimum": 0,
            "description": "1박 최대 요금(원). 없으면 비워 둔다"
          }
        },
        "required": [
          "city",
          "checkin",
          "checkout"
        ]
      },
      "output": {
        "hotels": {
          "type": "list",
          "description": "호텔",
          "fields": {
            "name": {
              "type": "string"
            },
            "hotel_id": {
              "type": "string",
              "description": "trip_com_prepare_hotel에 넘길 호텔 id"
            },
            "area": {
              "type": "string",
              "description": "위치 안내"
            },
            "rating": {
              "type": "number",
              "description": "평점 (10점 만점)"
            },
            "reviews": {
              "type": "integer"
            },
            "room": {
              "type": "string",
              "description": "추천 객실"
            },
            "price": {
              "type": "integer",
              "description": "1박 요금(원)"
            },
            "total_price": {
              "type": "integer",
              "description": "총금액(원, 세금·서비스비 포함)"
            },
            "free_cancel": {
              "type": "string",
              "description": "무료 취소·취소 가능 표시"
            },
            "rooms_left": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "examples": [
        {
          "city": "도쿄 228",
          "checkin": "2026-12-10",
          "checkout": "2026-12-12",
          "adults": 2
        }
      ],
      "steps": [
        {
          "open": "https://kr.trip.com/hotels/list?city={{city|digits}}&checkin={{checkin}}&checkout={{checkout}}&adult={{adults}}&crn={{rooms}}&children=0&curr=KRW"
        },
        {
          "wait": {
            "items": "div[class*='hotel-card'][id]",
            "timeoutMs": 20000
          }
        },
        {
          "extract": {
            "items": "div[class*='hotel-card'][id]",
            "limit": 30,
            "fields": {
              "name": {
                "line": 0
              },
              "hotel_id": {
                "attr": "id"
              },
              "area": {
                "match": "\\n([^\\n]+)지도\\n"
              },
              "rating": {
                "match": "\\n(\\d{1,2}\\.\\d)\\n"
              },
              "reviews": {
                "match": "리뷰 ([\\d,]+)개"
              },
              "room": {
                "css": "[class*='room-name']"
              },
              "price": {
                "match": "([\\d,]+)원\\n총금액"
              },
              "total_price": {
                "match": "총금액: ([\\d,]+)원"
              },
              "free_cancel": {
                "match": "\\n(무료 취소|[^\\n]*취소 가능)\\n"
              },
              "rooms_left": {
                "match": "(단 \\d+개 남았어요)"
              },
              "link": {
                "css": "a[href*='hotelId=']",
                "attr": "href",
                "match": "^([^#]+?)&hoteluniquekey"
              },
              "image": {
                "image": true
              }
            }
          },
          "as": "found"
        },
        {
          "filter": {
            "from": "found",
            "where": "price",
            "op": "lte",
            "value": "{{max_price}}"
          },
          "as": "hotels"
        }
      ],
      "result": {
        "hotels": "{{hotels}}"
      },
      "next": "평점·리뷰 수·위치·1박 요금(총금액도)·무료 취소를 견줘 2~3곳을 짧게 보여 주고 고르게 해요. 예약하려면 trip_com_prepare_hotel에 hotel_id·날짜·인원을 넘겨요.",
      "minIntervalSec": 300
    },
    {
      "name": "prepare_hotel",
      "title": "호텔 예약 준비",
      "description": "trip_com_hotel_search로 고른 호텔 화면을 그 날짜·인원·객실 수로 열어 객실별 요금·취소 규정·조식·남은 객실을 읽고, 사용자가 고른 객실의 '예약'까지 데려간다. 결제·예약 확정은 사용자 승인(browser_request_approval)을 받아야만 한다. 로그인을 요구하면 연결 전엔 connect_ask('trip-com').",
      "tier": "돈 내기",
      "login": false,
      "status": "초안",
      "input": {
        "properties": {
          "hotel_id": {
            "type": "string",
            "description": "trip_com_hotel_search가 준 호텔 id (예: 994914)",
            "pattern": "^\\d{1,12}$"
          },
          "hotel": {
            "type": "string",
            "description": "호텔 이름 (사용자에게 보일 말)",
            "maxLength": 80
          },
          "checkin": {
            "type": "string",
            "format": "date",
            "description": "체크인 YYYY-MM-DD"
          },
          "checkout": {
            "type": "string",
            "format": "date",
            "description": "체크아웃 YYYY-MM-DD"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 2,
            "description": "성인 인원"
          },
          "rooms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "description": "객실 수"
          },
          "room_wish": {
            "type": "string",
            "description": "원하는 객실 조건 (예: 무료 취소, 조식 포함). 없으면 비워 둔다",
            "maxLength": 80
          }
        },
        "required": [
          "hotel_id",
          "checkin",
          "checkout"
        ]
      },
      "output": {},
      "examples": [
        {
          "hotel_id": "994914",
          "hotel": "도쿄 프린스 호텔",
          "checkin": "2026-12-10",
          "checkout": "2026-12-12",
          "adults": 2
        }
      ],
      "steps": [
        {
          "open": "https://kr.trip.com/hotels/detail/?hotelId={{hotel_id|digits}}&checkIn={{checkin}}&checkOut={{checkout}}&adult={{adults}}&children=0&crn={{rooms}}&curr=KRW"
        },
        {
          "wait": {
            "text": "객실 선택|예약|객실 유형|만실",
            "timeoutMs": 20000
          }
        },
        {
          "handoff_to_agent": "트립닷컴 {{hotel}} {{checkin}}~{{checkout}} 성인 {{adults}}명 객실 {{rooms}}개 화면이에요. 객실 목록에서 객실마다 이름·침대·1박/총 요금(세금 포함)·취소 규정(무료 취소 기한)·조식·남은 객실을 읽어 사용자 바람({{room_wish}})에 맞는 2~3개를 보여 주고 고르게 해요. 고르면 그 줄의 '예약'을 누르고, 예약 정보 화면에서 호텔·객실·날짜·인원·총 금액·취소 규정을 정리해 browser_request_approval로 승인받은 뒤에만 결제로 넘어가요. 투숙객 이름은 사용자에게 묻고(여권 영문), 카드 정보는 사람이 직접 넣게 browser_handoff. 로그인을 요구하면 연결 전엔 connect_ask('trip-com')."
        }
      ],
      "result": {}
    },
    {
      "name": "orders",
      "title": "예약 확인",
      "description": "로그인해야 된다. 트립닷컴 '내 예약' 화면을 열어 다가오는 예약부터 항공·호텔·기차 종류, 이름(항공편·호텔), 날짜, 인원, 금액, 상태(확정·취소)를 정리한다. 취소·변경은 사용자가 그 예약을 콕 집어 부탁하고 수수료·환불 금액을 승인받아야만 한다.",
      "tier": "찾아보기",
      "login": true,
      "status": "초안",
      "input": {
        "properties": {},
        "required": []
      },
      "output": {},
      "examples": [
        {}
      ],
      "steps": [
        {
          "open": "https://kr.trip.com/order/all"
        },
        {
          "sleep": 2500
        },
        {
          "wait": {
            "text": "로그인|회원가입|내 예약|예약 내역|예약이 없",
            "timeoutMs": 12000
          },
          "optional": true
        },
        {
          "stop_if": "로그인/회원가입|이메일로 계속|로그인 또는 회원가입|로그인하고",
          "say": "트립닷컴 로그인이 필요해요. 연결하면 예약을 바로 볼 수 있어요.",
          "login": true
        },
        {
          "handoff_to_agent": "트립닷컴 내 예약 화면이에요. 다가오는 예약부터 종류(항공·호텔·기차)·항공편/호텔 이름·날짜·인원·금액·상태를 읽어 짧게 정리해요. 예약 번호는 끝 4자리만 보여 줘요. 로그인 화면이면 연결 전엔 connect_ask('trip-com'), 풀렸으면 browser_handoff. 취소·변경 버튼은 사용자가 그 예약을 콕 집어 부탁하고 수수료·환불 금액을 browser_request_approval로 승인받기 전에는 누르지 않아요."
        }
      ],
      "result": {}
    }
  ]
}
