{
  "id": "tving",
  "tools": [
    {
      "name": "search",
      "title": "작품 찾기",
      "description": "로그인 없이 된다. 티빙에서 작품 이름·출연자·주제어로 시리즈(드라마·예능)와 영화를 찾아 이름과 작품 번호를 돌려준다. 영화 줄은 검색어와 비슷한 추천도 섞여 있다. 줄거리·출연·회차는 tving_content에 content_id를 넘긴다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-18, 시리즈·영화 검색, 화면 읽기)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "작품 이름·출연자·주제어 (예: 환승연애, 유재석, 연애)",
            "maxLength": 50
          }
        },
        "required": [
          "keyword"
        ]
      },
      "output": {
        "series": {
          "type": "list",
          "description": "시리즈(드라마·예능) 검색 결과",
          "fields": {
            "name": {
              "type": "string",
              "description": "작품 이름"
            },
            "content_id": {
              "type": "string",
              "description": "티빙 작품 번호 (P로 시작)"
            },
            "image": {
              "type": "string",
              "description": "포스터 (카드에 넣어요)"
            },
            "link": {
              "type": "string",
              "description": "작품 주소"
            }
          }
        },
        "movies": {
          "type": "list",
          "description": "영화 검색 추천",
          "fields": {
            "name": {
              "type": "string",
              "description": "영화 이름"
            },
            "content_id": {
              "type": "string",
              "description": "티빙 작품 번호 (M으로 시작)"
            },
            "image": {
              "type": "string",
              "description": "포스터 (카드에 넣어요)"
            },
            "link": {
              "type": "string",
              "description": "작품 주소"
            }
          }
        }
      },
      "examples": [
        {
          "keyword": "환승연애"
        },
        {
          "keyword": "유재석"
        }
      ],
      "steps": [
        {
          "open": "https://www.tving.com/search?keyword={{keyword|url}}"
        },
        {
          "wait": {
            "text": "고객센터",
            "timeoutMs": 12000
          }
        },
        {
          "sleep": 1500
        },
        {
          "press": "PageDown"
        },
        {
          "sleep": 800
        },
        {
          "press": "PageDown"
        },
        {
          "sleep": 800
        },
        {
          "wait": {
            "items": "section[data-band-name] a[href^=\"/contents/\"]",
            "timeoutMs": 15000
          }
        },
        {
          "extract": {
            "items": "section[data-band-name*=\"시리즈\"] a[href^=\"/contents/\"]",
            "limit": 30,
            "fields": {
              "name": {
                "css": "img",
                "attr": "alt",
                "match": "^(.+?) (?:포스터|썸네일)$"
              },
              "content_id": {
                "attr": "href",
                "match": "/contents/([A-Z]\\d+)"
              },
              "image": {
                "image": true
              },
              "link": {
                "attr": "href"
              }
            }
          },
          "as": "series",
          "min": 0
        },
        {
          "extract": {
            "items": "section[data-band-name*=\"영화\"] a[href^=\"/contents/\"]",
            "limit": 20,
            "fields": {
              "name": {
                "css": "img",
                "attr": "alt",
                "match": "^(.+?) (?:포스터|썸네일)$"
              },
              "content_id": {
                "attr": "href",
                "match": "/contents/([A-Z]\\d+)"
              },
              "image": {
                "image": true
              },
              "link": {
                "attr": "href"
              }
            }
          },
          "as": "movies",
          "min": 0
        }
      ],
      "result": {
        "series": "{{series}}",
        "movies": "{{movies}}"
      },
      "next": "찾던 작품이 맞는지 이름 몇 개로 물어요. 자세한 정보는 tving_content, 찜은 tving_wishlist.",
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "content_id"
        ]
      },
      "minIntervalSec": 600
    },
    {
      "name": "browse",
      "title": "분류별 작품 보기",
      "description": "로그인 없이 된다. 티빙 분류 화면(드라마·예능·영화·애니)을 열어 묶음(예: 실시간 인기 예능, 지금 방영 중인 예능, 따끈한 최신회차 모음)마다 작품 이름과 작품 번호를 돌려준다. '이번 주말 몰아볼 예능', '새로 올라온 드라마'에 쓴다. 자세한 정보는 tving_content.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-18, 예능·드라마 묶음, 화면 읽기)",
      "input": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "drama",
              "entertainment",
              "movie",
              "animation"
            ],
            "default": "drama",
            "description": "분류: drama 드라마, entertainment 예능, movie 영화, animation 애니"
          },
          "section": {
            "type": "string",
            "description": "묶음 이름 일부로 좁히기 (예: 인기, 방영 중, 최신). 비우면 전체",
            "maxLength": 30,
            "default": ""
          }
        },
        "required": [
          "category"
        ]
      },
      "output": {
        "sections": {
          "type": "list",
          "description": "화면의 묶음",
          "fields": {
            "section": {
              "type": "string",
              "description": "묶음 이름"
            },
            "titles": {
              "type": "strings",
              "description": "작품 이름 (순서대로, 회차 묶음은 회차 이름)"
            },
            "content_ids": {
              "type": "strings",
              "description": "작품 번호 (titles와 같은 순서)"
            }
          }
        }
      },
      "examples": [
        {
          "category": "entertainment"
        },
        {
          "category": "drama"
        }
      ],
      "steps": [
        {
          "open": "https://www.tving.com/{{category}}"
        },
        {
          "wait": {
            "text": "고객센터",
            "timeoutMs": 12000
          }
        },
        {
          "sleep": 1500
        },
        {
          "press": "PageDown"
        },
        {
          "sleep": 800
        },
        {
          "press": "PageDown"
        },
        {
          "sleep": 800
        },
        {
          "wait": {
            "items": "section[data-band-name] a[href^=\"/contents/\"]",
            "timeoutMs": 15000
          }
        },
        {
          "sleep": 1000
        },
        {
          "extract": {
            "items": "section[data-band-name]:has(a[href^=\"/contents/\"])",
            "limit": 20,
            "fields": {
              "section": {
                "attr": "data-band-name"
              },
              "titles": {
                "css": "a[href^=\"/contents/\"] img",
                "attr": "alt",
                "match": "^(.+?) (?:포스터|썸네일)$",
                "list": true
              },
              "content_ids": {
                "css": "a[href^=\"/contents/\"]:has(img)",
                "attr": "href",
                "match": "/contents/([A-Z]\\d+)",
                "list": true
              }
            }
          },
          "as": "rows",
          "min": 1
        },
        {
          "filter": {
            "from": "rows",
            "where": "section",
            "op": "contains",
            "value": "{{section}}"
          },
          "as": "sections"
        }
      ],
      "result": {
        "sections": "{{sections}}"
      },
      "next": "부탁에 맞는 묶음에서 3~5편을 이름으로 보여 줘요. 자세히 보려면 tving_content에 content_ids의 번호를 넘겨요.",
      "expect": {
        "rows": 3,
        "filled": [
          "section",
          "titles",
          "content_ids"
        ]
      },
      "minIntervalSec": 3600,
      "cards": false
    },
    {
      "name": "content",
      "title": "작품 정보",
      "description": "로그인 없이 된다. 티빙 작품 번호로 작품 화면을 열어 이름·연도·분류·시즌 수·총 회차·출연·줄거리와 회차 목록(앞쪽)을 돌려준다. 번호는 tving_search·tving_browse에서. 보기는 이용권이 있어야 한다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-18, 작품 정보·회차, 화면 읽기)",
      "input": {
        "properties": {
          "content_id": {
            "type": "string",
            "description": "작품 번호 (예: P001496087, M000280735)",
            "pattern": "^[A-Z]\\d{6,12}$"
          }
        },
        "required": [
          "content_id"
        ]
      },
      "output": {
        "name": {
          "type": "string",
          "description": "작품 이름 (화면 제목, 회차 포함)"
        },
        "year": {
          "type": "string",
          "description": "연도"
        },
        "seasons": {
          "type": "string",
          "description": "시즌 수"
        },
        "episodes": {
          "type": "string",
          "description": "이 시즌 총 회차"
        },
        "cast": {
          "type": "string",
          "description": "출연"
        },
        "episode_list": {
          "type": "list",
          "description": "회차 (앞쪽)",
          "fields": {
            "title": {
              "type": "string",
              "description": "회차 제목"
            },
            "aired": {
              "type": "string",
              "description": "방송일·길이"
            }
          }
        },
        "url": {
          "type": "string",
          "description": "작품 화면 주소"
        }
      },
      "examples": [
        {
          "content_id": "P001496087"
        }
      ],
      "steps": [
        {
          "open": "https://www.tving.com/contents/{{content_id}}"
        },
        {
          "wait": {
            "items": "[data-testid=\"content-detail-cta-button\"]",
            "timeoutMs": 15000
          }
        },
        {
          "extract": {
            "items": "h1",
            "limit": 1,
            "fields": {
              "name": {}
            }
          },
          "as": "head",
          "min": 1
        },
        {
          "find": {
            "year": "\\n((?:19|20)\\d{2})\\n",
            "seasons": "(시즌 \\d+개)",
            "episodes": "\\(총 (\\d+)화\\)",
            "cast": "\\n출연\\n([^\\n]+)"
          },
          "as": "info"
        },
        {
          "extract": {
            "items": "[data-testid=\"swiper-list-item\"]:has(p)",
            "limit": 12,
            "fields": {
              "title": {
                "line": 0
              },
              "aired": {
                "match": "(\\d{4}\\.\\d{2}\\.\\d{2}\\s*\\|\\s*\\d+분)"
              }
            }
          },
          "as": "eps",
          "min": 0
        },
        {
          "filter": {
            "from": "eps",
            "where": "aired",
            "op": "has"
          },
          "as": "episode_list"
        }
      ],
      "result": {
        "name": "{{head.0.name}}",
        "year": "{{info.year}}",
        "seasons": "{{info.seasons}}",
        "episodes": "{{info.episodes}}",
        "cast": "{{info.cast}}",
        "episode_list": "{{episode_list}}",
        "url": "https://www.tving.com/contents/{{content_id}}"
      },
      "next": "이름·연도·출연과 최근 회차 하나를 짧게 말해요. 찜해 달라고 하면 tving_wishlist.",
      "expect": {
        "filled": [
          "name"
        ]
      },
      "minIntervalSec": 3600,
      "cards": false
    },
    {
      "name": "history",
      "title": "시청 내역",
      "description": "로그인해야 된다. 티빙 시청 내역(최근 3개월)을 열어 작품·회차·어디까지 봤는지를 읽는다. '어제 보던 거 어디까지 봤어?'에 쓴다. 프로필 고르기가 나오면 기억해 둔 내 프로필(없으면 사용자 이름과 같은 프로필)을 고르고, 그래도 모르면 빠른 답으로 묻는다.",
      "tier": "찾아보기",
      "login": true,
      "status": "초안",
      "input": {
        "properties": {},
        "required": []
      },
      "output": {},
      "examples": [
        {}
      ],
