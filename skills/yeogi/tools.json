            "type": "string",
            "format": "date",
            "description": "체크아웃 YYYY-MM-DD"
          },
          "people": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 2,
            "description": "인원"
          },
          "room": {
            "type": "string",
            "description": "yeogi_rooms에서 고른 객실 이름 (예: 슈페리어 더블 (노오션뷰))",
            "maxLength": 120
          }
        },
        "required": [
          "stay_id",
          "checkin",
          "checkout",
          "room"
        ]
      },
      "output": {},
      "examples": [
        {
          "stay_id": "48951",
          "stay": "세인트존스 호텔",
          "checkin": "2026-11-28",
          "checkout": "2026-11-29",
          "people": 2,
          "room": "슈페리어 더블 (노오션뷰) [굿초이스]"
        }
      ],
      "steps": [
        {
          "open": "https://www.yeogi.com/domestic-accommodations/{{stay_id|digits}}?checkIn={{checkin}}&checkOut={{checkout}}&personal={{people}}"
        },
        {
          "wait": {
            "text": "객실 선택|객실 예약|예약마감|다른 날짜",
            "timeoutMs": 15000
          }
        },
        {
          "require": "{{room|re}}",
          "say": "{{stay}}에 '{{room}}' 객실이 {{checkin}}~{{checkout}}에 안 보여요(마감이거나 이름이 달라요). yeogi_rooms로 남은 객실을 다시 볼 수 있어요.",
          "timeoutMs": 6000
        },
        {
          "handoff_to_agent": "여기어때 {{stay}} {{checkin}}~{{checkout}} {{people}}명 객실 선택 화면이에요. '{{room}}' 객실 카드에서 '숙박'의 '객실 예약'을 눌러요(대실 버튼은 누르지 않아요). 예약 화면이 뜨면 숙소·객실·날짜·인원·총 결제 금액·취소 규정을 정리해 두고, 결제 화면의 마지막 결제 버튼에서 결제 카드(browser_checkout)로 승인받아요. 로그인 화면이 나오면 connect_ask('yeogi')(연결한 적이 있으면 두리가 그때 쓴 방법으로 알아서 다시 로그인해요). 승인 뒤 결제 창까지 마치고 완료 화면의 예약번호로 browser_order_done."
        }
      ],
      "result": {}
    },
    {
      "name": "reservations",
      "title": "예약 내역",
      "description": "로그인해야 된다. 여기어때 예약 내역을 열어 다가오는 예약부터 숙소 이름·객실·체크인/체크아웃·인원·결제 금액·상태(예약 확정·이용 완료·취소)를 정리한다. 취소는 사용자가 그 예약을 콕 집어 부탁하고 취소 규정을 승인받아야만 한다.",
      "tier": "찾아보기",
      "login": true,
      "status": "초안",
      "input": {
        "properties": {},
        "required": []
      },
      "output": {},
      "examples": [
        {}
      ],
      "steps": [
        {
          "open": "https://www.yeogi.com/profile/settings"
        },
        {
          "wait": {
            "text": "예약 내역",
            "timeoutMs": 12000
          }
        },
        {
          "click": {
            "text": "예약 내역"
          }
        },
        {
          "wait": {
