        },
        {
          "click": {
            "text": "극장을 선택해 주세요"
          }
        },
        {
          "wait": {
            "text": "서울\\(\\d+\\)",
            "timeoutMs": 8000
          }
        },
        {
          "click": {
            "text": "{{region}}("
