{
  "id": "korea-kr",
  "tools": [
    {
      "name": "events",
      "title": "진행 중인 정부 이벤트",
      "description": "로그인 없이 된다. 정책브리핑(korea.kr) '진행 중인 이벤트' 게시판의 정부 부처·청 이벤트(퀴즈·공모전·참여 이벤트·기자단 모집)를 기간과 이벤트 누리집 주소와 함께 돌려준다. '공공기관 퀴즈·이벤트 응모', '정부 이벤트 뭐 있어'에는 기사 검색 말고 이것을 먼저 쓴다. 참여 대상·경품·응모 방법은 목록에 없으니 고른 이벤트의 link를 browser_open으로 열어 읽고, 사용자가 응모까지 부탁했으면 되는 것은 직접 응모한다(이름·연락처를 넘기는 응모는 승인을 받는다).",
      "tier": "lookup",
      "login": false,
      "status": "검증됨(2026-11-26, 진행 중 이벤트 12개 목록 — 제목·기간·누리집 주소·사진, 화면 읽기)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "제목에 든 말로 거르기 (예: 퀴즈). 비우면 전부"
          }
        }
      },
      "output": {
        "events": {
          "type": "list",
          "description": "진행 중인 이벤트 (마감 가까운 순)",
          "fields": {
            "title": {
              "type": "string",
              "description": "[부처] 이벤트 이름"
            },
            "period": {
              "type": "string",
              "description": "기간 (예: 2026.11.02 ~ 2026.11.20)"
            },
            "link": {
              "type": "string",
              "description": "이벤트 누리집 (참여 대상·응모는 여기서)"
            },
            "image": {
              "type": "string"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "title",
          "period",
          "link"
        ]
      },
      "examples": [
        {}
      ],
      "steps": [
        {
          "open": "https://www.korea.kr/etc/byulBeforeList.do?period=ing"
        },
        {
          "wait": {
            "items": ".list_type.event li",
            "timeoutMs": 12000
          }
        },
        {
          "extract": {
            "items": ".list_type.event li",
            "limit": 40,
            "fields": {
              "title": {
                "css": "strong"
              },
              "period": {
                "css": ".source span",
                "match": "(\\d{4}\\.\\d{2}\\.\\d{2}\\s*~\\s*\\d{4}\\.\\d{2}\\.\\d{2})"
              },
              "link": {
                "css": "a",
                "attr": "href"
              },
              "image": {
                "css": "img",
                "attr": "src"
              }
            }
          },
          "as": "all"
        },
        {
          "filter": {
            "from": "all",
            "where": "title",
            "op": "contains",
            "value": "{{keyword}}"
          },
          "as": "events"
        }
      ],
      "result": {
        "events": "{{events}}"
      },
      "next": "이벤트마다 link를 열어 참여 대상·경품·응모 방법을 읽고, show_list로 줄마다 이름·부처, 내가 되는지(state), 마감(date), link를 보여 준 뒤 되는 것부터 응모해요.",
      "minIntervalSec": 600,
      "cards": false
    }
  ]
}