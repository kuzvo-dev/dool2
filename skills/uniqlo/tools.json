          "size_code": {
            "type": "string",
            "description": "사이즈 코드 세 자리 (예: 005)",
            "pattern": "^\\d{3}$"
          },
          "store": {
            "type": "string",
            "description": "매장 이름이나 동네 (예: 강남, 명동중앙, 판교)",
            "maxLength": 30
          },
          "price_group": {
            "type": "string",
            "default": "00",
            "description": "가격 그룹 (기본 00)",
            "pattern": "^\\d{2}$"
          }
        },
        "required": [
          "product_no",
          "color_code",
          "size_code",
