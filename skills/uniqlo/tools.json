{
  "id": "uniqlo",
  "tools": [
    {
      "name": "search",
      "title": "상품 찾기",
      "description": "로그인 없이 된다. 유니클로(GU 포함)에서 검색어로 상품을 찾아 이름·성별·사이즈 범위·가격·할인 표시·별점·상품 번호·가격 그룹·보이는 색상 코드·링크·사진을 돌려준다. 검색 화면을 열어 상품 칸을 읽는다(첫 화면 24개 안팎). 재고는 uniqlo_stock(매장은 uniqlo_store_stock)에 product_no·color_code와 사이즈 코드를 넘긴다 — 사이즈 코드: XS 002·S 003·M 004·L 005·XL 006·XXL 007·3XL 008. 다른 색상은 상품 링크를 열면 보인다. 주문은 uniqlo_prepare_order. 세일 알림은 goal_create로 하루 한 번 불러 가격·할인 표시가 바뀌었는지 보면 된다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-20, 히트텍·니트 검색, 성별·가격 거르기, 화면의 상품 칸 읽기 — 검색 결과가 서버 렌더링으로 바뀜)",
      "input": {
        "properties": {
          "keyword": {
            "type": "string",
            "description": "찾을 상품 (예: 히트텍 크루넥, 스웨터, 울트라라이트다운, 배럴진)",
            "maxLength": 40
          },
          "gender": {
            "type": "string",
            "enum": [
              "WOMEN",
              "MEN",
              "KIDS",
              "BABY",
              "UNISEX"
            ],
            "description": "성별로 거르기 (비우면 모두)"
          },
          "max_price": {
            "type": "integer",
            "minimum": 0,
            "description": "최대 가격(원). 없으면 비워 둔다"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "default": 10,
            "description": "몇 개까지 (기본 10)"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "output": {
        "products": {
          "type": "list",
          "description": "상품",
          "fields": {
            "name": {
              "type": "string"
            },
            "gender": {
              "type": "string",
              "description": "WOMEN·MEN·KIDS·BABY·UNISEX"
            },
            "sizes": {
              "type": "string",
              "description": "사이즈 범위 (예: XS-3XL)"
            },
            "product_no": {
              "type": "string",
              "description": "uniqlo_stock·prepare_order에 넘길 상품 번호 (E465734-000처럼)"
            },
            "price_group": {
              "type": "string",
              "description": "가격 그룹 (보통 00, 할인 상품은 01 등)"
            },
            "color_code": {
              "type": "string",
              "description": "칸에 보이는 색상 코드 두 자리"
            },
            "price": {
              "type": "string",
              "description": "가격 (원)"
            },
            "sale": {
              "type": "string",
              "description": "가격인하·옵션할인·기간한정 표시 (있을 때만)"
            },
            "rating": {
              "type": "string",
              "description": "별점 (5점 만점)"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "product_no",
          "price",
          "link"
        ]
      },
      "examples": [
        {
          "keyword": "스웨터"
        },
        {
          "keyword": "히트텍 크루넥",
          "gender": "MEN",
          "limit": 5
        }
      ],
      "steps": [
        {
          "open": "https://www.uniqlo.com/kr/ko/search?q={{keyword|url}}"
        },
        {
          "wait": {
            "text": "결과:|검색 결과가 없|일치하는 상품이 없",
            "timeoutMs": 15000
          }
        },
        {
          "stop_if": "검색 결과가 없|일치하는 상품이 없",
          "say": "유니클로에서 '{{keyword}}'로 나온 상품이 없어요. 낱말을 줄여 다시 찾아요."
        },
        {
          "extract": {
            "items": "a.product-tile__link, a[href*='/products/E']",
            "limit": 40,
            "fields": {
              "name": {
                "line": 1
              },
              "gender": {
                "line": 0,
                "match": "^(WOMEN|MEN|KIDS|BABY|UNISEX)"
              },
              "sizes": {
                "line": 0,
                "match": ", ?(.+)$"
              },
              "product_no": {
                "attr": "href",
                "match": "/products/([A-Z]?\\d{6}-\\d{3})"
              },
              "price_group": {
                "attr": "href",
                "match": "/products/[A-Z]?\\d{6}-\\d{3}/(\\d{2})"
              },
              "color_code": {
                "attr": "href",
                "match": "colorDisplayCode=(\\d{2})"
              },
              "price": {
                "match": "([\\d,]+)원"
              },
              "sale": {
                "match": "(가격인하|옵션할인|기간한정[^\\n,]*)"
              },
              "rating": {
                "match": "\\n(\\d\\.\\d)(?:\\n|$)"
              },
              "link": {
                "attr": "href"
              },
              "image": {
                "image": true
              }
            }
          },
          "as": "all",
          "min": 0
        },
        {
          "filter": {
            "from": "all",
            "where": "product_no",
            "op": "has"
          },
          "as": "real"
        },
        {
          "filter": {
            "from": "real",
            "where": "gender",
            "op": "eq",
            "value": "{{gender}}"
          },
          "as": "g"
        },
        {
          "filter": {
            "from": "g",
            "where": "price",
            "op": "lte",
            "value": "{{max_price}}"
          },
          "as": "cheap"
        },
        {
          "map": {
            "from": "cheap",
            "limit": "{{limit}}",
            "fields": {
              "name": "name",
              "gender": "gender",
              "sizes": "sizes",
              "product_no": "product_no",
              "price_group": "price_group",
              "color_code": "color_code",
              "price": "price",
              "sale": "sale",
              "rating": "rating",
              "link": "link",
              "image": "image"
            }
          },
          "as": "products"
        }
      ],
      "result": {
        "products": "{{products}}"
      },
      "next": "값이 맞는 것 3~5개를 이름·가격(할인가)·별점으로 짧게 보여 줘요. 사용자가 색상·사이즈를 말했으면 그 코드로 uniqlo_stock을 불러 온라인 재고를 확인해요.",
      "minIntervalSec": 600
    },
    {
      "name": "stock",
      "title": "사이즈 재고 보기",
      "description": "로그인 없이 된다. 유니클로 상품 화면을 그 색상·사이즈로 열어 온라인 재고(재고 있음·재고 적음·품절)와 지금 가격, 화면에 고른 색상·사이즈 이름을 돌려준다. 색상 코드·사이즈 코드는 uniqlo_search의 color_codes·size_codes에서 고른다(예: 블랙 09, L 005). 매장 재고는 uniqlo_store_stock.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-18, 색상·사이즈 코드로 온라인 재고·가격)",
      "input": {
        "properties": {
          "product_no": {
            "type": "string",
            "description": "uniqlo_search가 준 상품 번호 (예: E465734-000)",
            "pattern": "^[A-Z]?\\d{6}-\\d{3}$"
          },
          "color_code": {
            "type": "string",
            "description": "색상 코드 두 자리 (예: 09)",
            "pattern": "^\\d{2}$"
          },
          "size_code": {
            "type": "string",
            "description": "사이즈 코드 세 자리 (예: 005)",
            "pattern": "^\\d{3}$"
          },
          "price_group": {
            "type": "string",
            "default": "00",
            "description": "가격 그룹 (기본 00)",
            "pattern": "^\\d{2}$"
          }
        },
        "required": [
          "product_no",
          "color_code",
          "size_code"
        ]
      },
      "output": {
        "color": {
          "type": "string",
          "description": "화면에 고른 색상 (예: 09 BLACK)"
        },
        "size": {
          "type": "string",
          "description": "화면에 고른 사이즈 (예: WOMEN L)"
        },
        "stock": {
          "type": "string",
          "description": "온라인 재고 (재고 있음·재고 적음·품절 등)"
        },
        "price": {
          "type": "string",
          "description": "지금 가격 (원)"
        },
        "link": {
          "type": "string"
        }
      },
      "expect": {
        "filled": [
          "color",
          "size",
          "stock"
        ]
      },
      "examples": [
        {
          "product_no": "E465734-000",
          "color_code": "09",
          "size_code": "005"
        }
      ],
      "steps": [
        {
          "open": "https://www.uniqlo.com/kr/ko/products/{{product_no}}/{{price_group}}?colorDisplayCode={{color_code}}&sizeDisplayCode={{size_code}}"
        },
        {
          "require": "장바구니에 담기|품절|재입고",
          "say": "이 상품 화면이 열리지 않았어요. 판매가 끝났거나 번호가 바뀌었을 수 있어요. uniqlo_search로 다시 찾아볼게요.",
          "timeoutMs": 12000
        },
        {
          "find": {
            "color": "컬러: ([^\\n]+)",
            "size": "사이즈: ([^\\n]+)",
            "stock": "(재고 있음|재고 적음|재고 부족|품절 임박|일시 품절|품절|재고 없음)",
            "price": "\\n([\\d,]+)원\\n"
          },
          "as": "f"
        }
      ],
      "result": {
        "color": "{{f.color}}",
        "size": "{{f.size}}",
        "stock": "{{f.stock}}",
        "price": "{{f.price}}",
        "link": "https://www.uniqlo.com/kr/ko/products/{{product_no}}/{{price_group}}?colorDisplayCode={{color_code}}&sizeDisplayCode={{size_code}}"
      },
      "next": "온라인 재고와 가격을 짧게 알려 줘요. 매장에서 사려면 uniqlo_store_stock, 주문하려면 uniqlo_prepare_order로 이어 가요.",
      "minIntervalSec": 600
    },
    {
