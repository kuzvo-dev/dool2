      "input": {
        "properties": {
          "product_no": {
            "type": "string",
            "description": "uniqlo_search가 준 상품 번호 (예: E465734-000)",
            "pattern": "^[A-Z]?\\d{6}-\\d{3}$"
          },
          "color_code": {
            "type": "string",
