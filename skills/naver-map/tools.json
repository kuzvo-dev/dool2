{
  "id": "naver-map",
  "tools": [
    {
      "name": "places",
      "title": "가게 찾기·영업 확인",
      "description": "로그인 없이 된다. 네이버 지도에서 '동네 + 무엇'(예: 망원동 칼국수, 성수 브런치, 강남역 약국)으로 가게를 찾아, 가게마다 지금 영업 상태(영업 중·곧 영업 시작·브레이크타임·오늘 휴무)와 다음 변화(예: 20:00에 라스트오더, 17:00에 영업 시작)·방문자 리뷰 수·한 줄 소개·주소·전화·사진·지도 주소를 돌려준다. '지금 문 열었어?', '몇 시까지 해?', '근처 ○○' 물음에 먼저 쓴다. 영업 상태가 비어 있으면 영업시간이 등록되지 않은 곳이니 '모름'으로 말하고 전화를 권한다. 음식점이면 kind=restaurant, 그 밖(카페·병원·약국·미용실 등)은 kind=place.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-19, 망원동 칼국수 12곳·영업 상태·다음 변화·사진, 화면에 박힌 데이터 읽기)",
      "input": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 40,
            "description": "동네와 찾을 것 (예: 망원동 칼국수, 성수 브런치 카페, 강남역 약국)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "place"
            ],
            "default": "restaurant",
            "description": "restaurant 음식점·술집 · place 그 밖의 가게(카페·병원·약국·미용실 등)"
          },
          "area": {
            "type": "string",
            "maxLength": 20,
            "description": "동네 이름 (예: 망원동, 성수동). 주면 주소에 이 이름이 든 곳만 돌려줘요. 역 이름·건물 이름이면 비워요"
          }
        },
        "required": [
          "query"
        ]
      },
      "output": {
        "places": {
          "type": "list",
          "description": "가게 (네이버 지도 순서)",
          "fields": {
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "description": "업종 (예: 칼국수,만두)"
            },
            "status": {
              "type": "string",
              "description": "지금 영업 상태 (영업 중·곧 영업 시작·브레이크타임·오늘 휴무·영업 종료). 비면 영업시간 정보 없음"
            },
            "next": {
              "type": "string",
              "description": "다음 변화 (예: 20:00에 라스트오더, 17:00에 영업 시작, 11/19 휴무)"
            },
            "reviews": {
              "type": "string",
              "description": "방문자 리뷰 수"
            },
            "blog": {
              "type": "string",
              "description": "블로그·카페 리뷰 수"
            },
            "short": {
              "type": "string",
              "description": "한 줄 소개 (리뷰 요약)"
            },
            "address": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "place_id": {
              "type": "string",
              "description": "네이버 지도 장소 번호"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "category",
          "link"
        ]
      },
      "examples": [
        {
          "query": "망원동 칼국수"
        },
        {
          "query": "성수 카페",
          "kind": "place"
        }
      ],
      "steps": [
        {
          "open": "https://pcmap.place.naver.com/{{kind}}/list?query={{query|url}}"
        },
        {
          "embedded": {
            "css": "script",
            "after": "__APOLLO_STATE__",
            "pick": "*"
          },
          "as": "all"
        },
        {
          "filter": {
            "from": "all",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceListBusinessesItem"
          },
          "as": "found"
        },
        {
          "filter": {
            "from": "found",
            "where": "fullAddress",
            "op": "contains",
            "value": "{{area}}"
          },
          "as": "found"
        },
        {
          "map": {
            "from": "found",
            "limit": 12,
            "fields": {
              "name": "name",
              "category": "category",
              "status": "newBusinessHours.status",
              "next": "newBusinessHours.description",
              "reviews": "visitorReviewCount",
              "blog": "blogCafeReviewCount",
              "short": "microReview",
              "address": "roadAddress",
              "phone": "{{#phone}}{{phone}}{{/phone}}{{^phone}}{{virtualPhone}}{{/phone}}",
              "place_id": "id",
              "link": "https://map.naver.com/p/entry/place/{{id}}",
              "image": "{{#imageUrl}}{{imageUrl}}{{/imageUrl}}{{^imageUrl}}{{visitorImages.0.imageUrl}}{{/imageUrl}}"
            }
          },
          "as": "places"
        }
      ],
      "result": {
        "places": "{{places}}"
      },
      "next": "show_list로 목록 줄을 붙여요(pick 없이): 물은 업종에 맞는 곳만 3~6줄, title=가게 이름, sub=다음 변화 · 짧은 주소(예: 20:00 라스트오더 · 망원로8길 29), state=영업 상태(비면 '모름'), tone=영업 중이면 done·곧 영업 시작/브레이크타임이면 wait·휴무/종료면 stop, url=link, title(머리)=\"<동네> <업종> · 지금 영업\", from=\"네이버 지도\". 업종이 다른 곳(고깃집·주점)은 빼요. 영업 상태가 빈 곳은 '영업시간 정보 없음'이니 전화를 권해요. 답 글은 결론 한 줄(지금 갈 만한 곳·가장 먼저 닫는 곳)만, 목록을 되풀이하지 않아요.",
      "minIntervalSec": 120
    }
  ]
}