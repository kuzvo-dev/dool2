{
  "id": "naver-map",
  "tools": [
    {
      "name": "places",
      "title": "가게 찾기·영업 확인",
      "description": "로그인 없이 된다. 네이버 지도에서 '동네 + 무엇'(예: 망원동 칼국수, 성수 브런치, 강남역 약국)으로 가게를 찾아, 가게마다 지금 영업 상태(영업 중·곧 영업 시작·브레이크타임·오늘 휴무)와 다음 변화(예: 20:00에 라스트오더, 17:00에 영업 시작)·방문자 리뷰 수·한 줄 소개·주소·전화·사진·지도 주소를 돌려준다. '지금 문 열었어?', '몇 시까지 해?', '근처 ○○' 물음에 먼저 쓴다. 영업 상태가 비어 있으면 영업시간이 등록되지 않은 곳이니 '모름'으로 말하고 전화를 권한다. 전기차 충전소는 naver_map_chargers를 써요(급속·빈 충전기 수가 나와요). 음식점이면 kind=restaurant, 그 밖(카페·병원·약국·미용실 등)은 kind=place.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-19, 망원동 칼국수 12곳·영업 상태·다음 변화·사진, 화면에 박힌 데이터 읽기)",
      "input": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 40,
            "description": "동네와 찾을 것 (예: 망원동 칼국수, 성수 브런치 카페, 강남역 약국)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "place"
            ],
            "default": "restaurant",
            "description": "restaurant 음식점·술집 · place 그 밖의 가게(카페·병원·약국·미용실 등)"
          },
          "area": {
            "type": "string",
            "maxLength": 20,
            "description": "동네 이름 (예: 망원동, 성수동). 주면 주소에 이 이름이 든 곳만 돌려줘요. 역 이름·건물 이름이면 비워요"
          }
        },
        "required": [
          "query"
        ]
      },
      "output": {
        "places": {
          "type": "list",
          "description": "가게 (네이버 지도 순서)",
          "fields": {
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "description": "업종 (예: 칼국수,만두)"
            },
            "status": {
              "type": "string",
              "description": "지금 영업 상태 (영업 중·곧 영업 시작·브레이크타임·오늘 휴무·영업 종료). 비면 영업시간 정보 없음"
            },
            "next": {
              "type": "string",
              "description": "다음 변화 (예: 20:00에 라스트오더, 17:00에 영업 시작, 11/19 휴무)"
            },
            "reviews": {
              "type": "string",
              "description": "방문자 리뷰 수"
            },
            "blog": {
              "type": "string",
              "description": "블로그·카페 리뷰 수"
            },
            "short": {
              "type": "string",
              "description": "한 줄 소개 (리뷰 요약)"
            },
            "address": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "place_id": {
              "type": "string",
              "description": "네이버 지도 장소 번호"
            },
            "link": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "description": "사진 (카드에 넣어요)"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "category",
          "link"
        ]
      },
      "examples": [
        {
          "query": "망원동 칼국수"
        },
        {
          "query": "성수 카페",
          "kind": "place"
        }
      ],
      "steps": [
        {
          "open": "https://pcmap.place.naver.com/{{kind}}/list?query={{query|url}}"
        },
        {
          "embedded": {
            "css": "script",
            "after": "__APOLLO_STATE__",
            "pick": "*"
          },
          "as": "all"
        },
        {
          "filter": {
            "from": "all",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceListBusinessesItem"
          },
          "as": "found"
        },
        {
          "filter": {
            "from": "found",
            "where": "fullAddress",
            "op": "contains",
            "value": "{{area}}"
          },
          "as": "found"
        },
        {
          "map": {
            "from": "found",
            "limit": 12,
            "fields": {
              "name": "name",
              "category": "category",
              "status": "newBusinessHours.status",
              "next": "newBusinessHours.description",
              "reviews": "visitorReviewCount",
              "blog": "blogCafeReviewCount",
              "short": "microReview",
              "address": "roadAddress",
              "phone": "{{#phone}}{{phone}}{{/phone}}{{^phone}}{{virtualPhone}}{{/phone}}",
              "place_id": "id",
              "link": "https://map.naver.com/p/entry/place/{{id}}",
              "image": "{{#imageUrl}}{{imageUrl}}{{/imageUrl}}{{^imageUrl}}{{visitorImages.0.imageUrl}}{{/imageUrl}}"
            }
          },
          "as": "places"
        }
      ],
      "result": {
        "places": "{{places}}"
      },
      "next": "show_list로 목록 줄을 붙여요(pick 없이): 물은 업종에 맞는 곳만 3~6줄, title=가게 이름, sub=다음 변화 · 짧은 주소(예: 20:00 라스트오더 · 망원로8길 29), state=영업 상태(비면 '모름'), tone=영업 중이면 done·곧 영업 시작/브레이크타임이면 wait·휴무/종료면 stop, url=link, title(머리)=\"<동네> <업종> · 지금 영업\", from=\"네이버 지도\". 업종이 다른 곳(고깃집·주점)은 빼요. 영업 상태가 빈 곳은 '영업시간 정보 없음'이니 전화를 권해요. 답 글은 결론 한 줄(지금 갈 만한 곳·가장 먼저 닫는 곳)만, 목록을 되풀이하지 않아요.",
      "minIntervalSec": 120
    },
    {
      "name": "chargers",
      "title": "전기차 충전소 찾기",
      "description": "로그인 없이 된다. 지역(강릉, 강남구 역삼동)이나 장소(횡성휴게소 강릉방향, 강릉역) 근처 전기차 충전소를 네이버 지도에서 찾아, 충전소마다 급속(초급속 포함)·완속 대수와 지금 비어 있는(충전가능) 대수·쓰는 중 대수·최대 출력·급속 커넥터·사업자·개방 여부·무료 주차·주소·장소 번호를 돌려준다. \"충전소 어디\", \"급속 비어 있어?\", \"가는 길에 충전\" 물음에 쓴다. 가는 길이면 길목 휴게소마다 따로 불러요(방향까지). 운영 시간·요금·이용 제한(투숙객 전용 등)은 naver_map_charger(place_id)로 봐요. 기본은 50kW 이상 급속이 있고 누구나 쓰는(개방) 곳만이에요.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-19, 강릉 15곳·횡성휴게소 강릉방향 15곳·급속 빈 대수·사업자, 화면에 박힌 데이터 읽기)",
      "input": {
        "properties": {
          "where": {
            "type": "string",
            "maxLength": 40,
            "description": "찾을 곳: 시·군·구·동 이름(예: 강릉, 강남구 역삼동) 또는 장소 이름(예: 횡성휴게소 강릉방향, 강릉역, 이마트 강릉점). 휴게소는 가는 방향까지"
          },
          "min_kw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 350,
            "default": 50,
            "description": "이 출력(kW) 이상 충전기가 있는 곳만. 50 급속(기본), 100·200 더 빠른 곳, 0이면 완속만 있는 곳도"
          },
          "public_only": {
            "type": "boolean",
            "default": true,
            "description": "true면 누구나 쓰는(개방) 충전소만. false면 아파트·호텔 투숙객 전용 같은 비개방도"
          }
        },
        "required": [
          "where"
        ]
      },
      "output": {
        "near": {
          "type": "string",
          "description": "장소로 찾았으면 그 장소 이름(목록은 그 근처, distance가 거리). 비면 지역으로 찾은 것"
        },
        "total": {
          "type": "integer",
          "description": "지역으로 찾았을 때 그 지역의 조건에 맞는 충전소 수 (목록은 앞 15곳)"
        },
        "stations": {
          "type": "list",
          "description": "충전소 (네이버 지도 관련도 순)",
          "fields": {
            "name": {
              "type": "string"
            },
            "operator": {
              "type": "string",
              "description": "충전 사업자 (예: 환경부, 차지비, 한국전력)"
            },
            "fast_free": {
              "type": "integer",
              "description": "지금 비어 있는 급속(초급속 포함) 대수"
            },
            "fast_busy": {
              "type": "integer",
              "description": "쓰는 중(충전 중)인 급속 대수"
            },
            "fast_total": {
              "type": "integer",
              "description": "급속 전체 대수 (비어 있음+쓰는 중보다 많으면 나머지는 점검 중이거나 상태를 몰라요)"
            },
            "fast_plug": {
              "type": "string",
              "description": "급속 커넥터 (DC콤보, 차데모, 수퍼차저V3 등. 수퍼차저는 그 회사 차 전용)"
            },
            "max_kw": {
              "type": "integer",
              "description": "가장 빠른 충전기 출력(kW)"
            },
            "slow_free": {
              "type": "integer",
              "description": "지금 비어 있는 완속·중속 대수"
            },
            "slow_total": {
              "type": "integer",
              "description": "완속·중속 전체 대수"
            },
            "summary": {
              "type": "string",
              "description": "네이버 지도 표시 (예: 충전가능 3/6, 상태미확인 0/1, 정보미제공 0/6)"
            },
            "is_public": {
              "type": "boolean",
              "description": "누구나 쓸 수 있는 개방 충전소인지"
            },
            "free_parking": {
              "type": "boolean",
              "description": "주차 무료인지"
            },
            "distance": {
              "type": "string",
              "description": "장소로 찾았을 때 그 장소에서 거리"
            },
            "address": {
              "type": "string"
            },
            "place_id": {
              "type": "string",
              "description": "네이버 지도 장소 번호 (naver_map_charger에 넘겨요)"
            },
            "link": {
              "type": "string"
            }
          }
        }
      },
      "expect": {
        "rows": 3,
        "filled": [
          "name",
          "operator",
          "fast_total",
          "address",
          "link"
        ]
      },
      "examples": [
        {
          "where": "강릉"
        },
        {
          "where": "횡성휴게소 강릉방향"
        }
      ],
      "steps": [
        {
          "open": "https://pcmap.place.naver.com/place/list?query={{where|url}}"
        },
        {
          "embedded": {
            "css": "script",
            "after": "__APOLLO_STATE__"
          },
          "as": "spot_page"
        },
        {
          "filter": {
            "from": "spot_page.*",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceListBusinessesItem"
          },
          "as": "spots"
        },
        {
          "open": "https://pcmap.place.naver.com/rest/evcs?query={{#spots.0.x}}%EC%A0%84%EA%B8%B0%EC%B0%A8%EC%B6%A9%EC%A0%84%EC%86%8C&x={{spots.0.x}}&y={{spots.0.y}}{{/spots.0.x}}{{^spots.0.x}}{{where|url}}%20%EC%A0%84%EA%B8%B0%EC%B0%A8%EC%B6%A9%EC%A0%84%EC%86%8C{{/spots.0.x}}&chargingspeed={{min_kw}}%3A999{{#public_only}}&evcsProperties=public{{/public_only}}"
        },
        {
          "embedded": {
            "css": "script",
            "after": "__APOLLO_STATE__"
          },
          "as": "ev_page"
        },
        {
          "filter": {
            "from": "ev_page.ROOT_QUERY.*",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceListResult"
          },
          "as": "res"
        },
        {
          "map": {
            "from": "res",
            "limit": 1,
            "fields": {
              "rc": "{{^spots.0.x}}{{businesses.analyzedQuery.rcode}}{{/spots.0.x}}",
              "n": "businesses.total"
            }
          },
          "as": "area_rows"
        },
        {
          "filter": {
            "from": "area_rows",
            "where": "rc",
            "op": "has"
          },
          "as": "area"
        },
        {
          "filter": {
            "from": "ev_page.*",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceListBusinessesItem"
          },
          "as": "found"
        },
        {
          "map": {
            "from": "found",
            "limit": 15,
            "fields": {
              "located": "{{spots.0.x}}{{res.0.businesses.analyzedQuery.rcode}}",
              "name": "name",
              "operator": "evChargingStationInfo.vendor",
              "fast_free": "evChargingStationInfo.chargers[powerType=급속|초급속][status=충전가능].length",
              "fast_busy": "evChargingStationInfo.chargers[powerType=급속|초급속][status=충전중|사용중].length",
              "fast_total": "evChargingStationInfo.chargers[powerType=급속|초급속].length",
              "fast_plug": "evChargingStationInfo.chargers[powerType=급속|초급속].0.connectorType",
              "max_kw": "evChargingStationInfo.powers.-1",
              "slow_free": "evChargingStationInfo.chargers[powerType=완속|중속][status=충전가능].length",
              "slow_total": "evChargingStationInfo.chargers[powerType=완속|중속].length",
              "summary": "markerLabel.text",
              "is_public": "evChargingStationInfo.isPublic",
              "free_parking": "evChargingStationInfo.isFreeParking",
              "distance": "{{#spots.0.x}}{{distance}}{{/spots.0.x}}",
              "address": "fullAddress",
              "place_id": "id",
              "link": "https://map.naver.com/p/entry/place/{{id}}"
            }
          },
          "as": "rows"
        },
        {
          "filter": {
            "from": "rows",
            "where": "located",
            "op": "has"
          },
          "as": "stations"
        }
      ],
      "result": {
        "near": "{{spots.0.name}}",
        "total": "{{area.0.n}}",
        "stations": "{{stations}}"
      },
      "next": "show_list(pick 없이)로 3~6곳: 빈 급속이 많은 곳부터, title=충전소 이름, sub=사업자 · 최대 kW · 짧은 주소, state=\"급속 <fast_free>/<fast_total> 비어 있음\", tone=빈 급속 있으면 done·다 충전 중이면 wait·상태 모르면 stop, url=link, from=\"네이버 지도\". 휴게소면 그 방향 이름만. 수퍼차저는 그 회사 차 전용. 상태는 몇 분 늦을 수 있어요. stations·near가 다 비면 위치를 못 찾은 것: 시·군 이름이나 근처 장소 이름으로 다시. near만 있으면 근처에 조건에 맞는 곳이 없는 것(min_kw를 낮추거나 public_only=false). 운영 시간·요금은 naver_map_charger.",
      "minIntervalSec": 120,
      "cards": false
    },
    {
      "name": "charger",
      "title": "충전소 자세히",
      "description": "로그인 없이 된다. naver_map_chargers가 준 place_id로 충전소 하나를 자세히 본다: 지금 영업 상태와 운영 시간, 이용 제한(투숙객 전용·입주민 전용 등), 충전 요금(회원·비회원 kWh당), 주차 요금, 사업자와 연락처, 충전기마다 종류·출력·커넥터·지금 상태·마지막 충전 시작 시각. 갈 곳을 정하기 전에 1~3곳만 확인할 때 쓴다.",
      "tier": "찾아보기",
      "login": false,
      "status": "검증됨(2026-11-19, 휴게소·호텔 충전소의 운영 시간·이용 제한·요금·충전기별 상태, 화면에 박힌 데이터 읽기)",
      "input": {
        "properties": {
          "place_id": {
            "type": "string",
            "pattern": "^\\d{5,12}$",
            "description": "naver_map_chargers가 준 장소 번호 (예: 1439847464)"
          }
        },
        "required": [
          "place_id"
        ]
      },
      "output": {
        "name": {
          "type": "string"
        },
        "open_now": {
          "type": "string",
          "description": "지금 영업 상태 (예: 24시간 영업, 영업 중, 영업 종료)"
        },
        "hours_note": {
          "type": "string",
          "description": "영업 상태 덧말 (예: 연중무휴, 22:00에 영업 종료)"
        },
        "hours": {
          "type": "strings",
          "description": "요일별 운영 시간 (모두 같으면 매일 그 시간)"
        },
        "access_limit": {
          "type": "string",
          "description": "이용 제한 (예: 투숙객 전용, 이용자 제한 없음)"
        },
        "notice": {
          "type": "string",
          "description": "안내 사항"
        },
        "prices": {
          "type": "list",
          "description": "충전 요금 (kWh당)",
          "fields": {
            "for": {
              "type": "string",
              "description": "충전기 (예: 급속 100kW)"
            },
            "member": {
              "type": "string",
              "description": "회원 요금"
            },
            "nonmember": {
              "type": "string",
              "description": "로밍·비회원 요금"
            }
          }
        },
        "parking": {
          "type": "string",
          "description": "주차 요금"
        },
        "free_parking": {
          "type": "boolean"
        },
        "spot": {
          "type": "string",
          "description": "충전소 위치 종류 (예: 주차장, 휴게소)"
        },
        "operator": {
          "type": "string",
          "description": "운영 기관"
        },
        "phone": {
          "type": "string",
          "description": "운영 기관 연락처"
        },
        "address": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "chargers": {
          "type": "list",
          "description": "충전기",
          "fields": {
            "kind": {
              "type": "string",
              "description": "초급속·급속·중속·완속"
            },
            "kw": {
              "type": "integer"
            },
            "plug": {
              "type": "string",
              "description": "커넥터"
            },
            "status": {
              "type": "string",
              "description": "충전가능·충전중·사용중·점검중·상태미확인·정보미제공"
            },
            "charge_start": {
              "type": "string",
              "description": "마지막 충전 시작 시각 (쓰는 중이면 이때부터)"
            }
          }
        }
      },
      "expect": {
        "rows": 1,
        "filled": [
          "kind",
          "kw",
          "status"
        ]
      },
      "examples": [
        {
          "place_id": "1439847464"
        },
        {
          "place_id": "1287853795"
        }
      ],
      "steps": [
        {
          "open": "https://pcmap.place.naver.com/place/{{place_id}}/home"
        },
        {
          "embedded": {
            "css": "script",
            "after": "__APOLLO_STATE__"
          },
          "as": "page"
        },
        {
          "filter": {
            "from": "page.ROOT_QUERY.*",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceDetail"
          },
          "as": "d"
        },
        {
          "filter": {
            "from": "page.*",
            "where": "__typename",
            "op": "eq",
            "value": "PlaceDetailBase"
          },
          "as": "b"
        },
        {
          "filter": {
            "from": "page.ROOT_QUERY.*",
            "where": "__typename",
            "op": "eq",
            "value": "EvChargingStationResult"
          },
          "as": "live"
        },
        {
          "map": {
            "from": "d",
            "limit": 1,
            "fields": {
              "open_now": "newBusinessHours.0.businessStatusDescription.status",
              "hours_note": "newBusinessHours.0.businessStatusDescription.description",
              "hours": "evChargingStation.operationTime"
            }
          },
          "as": "info"
        },
        {
          "map": {
            "from": "d.0.evChargingStation.chargingCost",
            "limit": 10,
            "fields": {
              "for": "power",
              "member": "memberCost",
              "nonmember": "nonMemberCost"
            }
          },
          "as": "prices"
        },
        {
          "map": {
            "from": "live.0.chargers",
            "limit": 40,
            "fields": {
              "kind": "powerType",
              "kw": "power",
              "plug": "connectorType",
              "status": "status",
              "charge_start": "chargeStartAt"
            }
          },
          "as": "chargers"
        }
      ],
      "result": {
        "name": "{{b.0.name}}",
        "open_now": "{{info.0.open_now}}",
        "hours_note": "{{info.0.hours_note}}",
        "hours": "{{info.0.hours}}",
        "access_limit": "{{d.0.evChargingStation.accessLimit}}",
        "notice": "{{d.0.evChargingStation.notice}}",
        "prices": "{{prices}}",
        "parking": "{{d.0.evChargingStation.parkingCost}}",
        "free_parking": "{{d.0.evChargingStation.freeParking}}",
        "spot": "{{d.0.evChargingStation.locationDetail}}",
        "operator": "{{d.0.evChargingStation.vendorName}}",
        "phone": "{{d.0.evChargingStation.vendorCall}}",
        "address": "{{b.0.address}}",
        "link": "https://map.naver.com/p/entry/place/{{place_id}}",
        "chargers": "{{chargers}}"
      },
      "next": "답은 결론 한 줄: 지금 쓸 수 있는지(빈 충전기 수)·운영 시간·이용 제한이 있으면 그것부터. 투숙객·입주민 전용이면 다른 곳을 권해요. 요금은 회원·비회원을 구분해 짧게. 상태는 몇 분 늦을 수 있어요.",
      "minIntervalSec": 60,
      "cards": false
    }
  ]
}
