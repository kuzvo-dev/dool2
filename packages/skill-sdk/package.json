{
  "name": "@dool2/skill-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dool2 skill system core: SKILL.md frontmatter parsing and the resolver that auto-injects a site skill by tab URL and by Korean keywords",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
