{
  "name": "@dool2/browser",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dool2's browser hands: checking and installing Chrome, and native messaging between the Dool2 extension and the daemon",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": "./dist/host-main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dool2/i18n": "workspace:*",
    "@dool2/protocol": "workspace:*",
    "@dool2/skill-learn": "workspace:*"
  },
  "devDependencies": {
    "@dool2/skill-sdk": "workspace:*"
  },
  "bin": {
    "dool2-browser-host": "./dist/host-main.js"
  }
}
