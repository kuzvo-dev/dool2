{
  "name": "@dool2/agent-opencode",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dool2 pay-as-you-go runner: runs OpenCode v2 with an API key, limited to Dool2 tools (ADR 0010)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dool2/i18n": "workspace:*",
    "@dool2/engine": "workspace:*",
    "@dool2/protocol": "workspace:*"
  }
}
