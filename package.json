{
  "name": "dool2",
  "private": true,
  "description": "Dool2: an AI assistant that lives on your computer",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && node scripts/check-hangul.mjs",
    "format": "biome check --write .",
    "dev:daemon": "pnpm build && pnpm --filter @dool2/daemon dev",
    "dev:desktop": "pnpm build && pnpm --filter @dool2/desktop dev",
    "connector": "node apps/daemon/scripts/connector.mjs",
    "eval:static": "node evals/static.mjs",
    "eval:run": "node evals/run.mjs",
    "eval:score": "node evals/score.mjs",
    "eval:nightly": "node evals/nightly.mjs",
    "report:harness": "node apps/daemon/scripts/report-harness.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
