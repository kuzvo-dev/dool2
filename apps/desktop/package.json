{
  "name": "@dool2/desktop",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dool2 desktop app — an AI assistant that lives on your computer",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "electron .",
    "smoke": "DOOL2_SMOKE=1 electron .",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@dool2/agent-codex": "workspace:*",
    "@dool2/browser": "workspace:*",
    "@dool2/daemon": "workspace:*",
    "@dool2/i18n": "workspace:*",
    "@dool2/mcp-tools": "workspace:*",
    "@dool2/protocol": "workspace:*"
  },
  "devDependencies": {
    "@dool2/ui": "workspace:*",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
