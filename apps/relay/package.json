{
  "name": "@dool2/relay",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "두리 중계 서버: 폰 ↔ PC 암호문만 이어 준다 (내용은 볼 수 없음)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dool2-relay": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@dool2/protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
