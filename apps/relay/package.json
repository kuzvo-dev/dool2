{
  "name": "@dool2/relay",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dool2 relay: forwards only ciphertext between phone and PC (cannot read the content)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dool2-relay": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "dev:cf": "wrangler dev --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dool2/protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/ws": "^8.18.1",
    "wrangler": "^4.162.0"
  }
}
