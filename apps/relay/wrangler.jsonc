// 두리 공식 중계 서버 (Cloudflare Workers + Durable Objects). 배포: pnpm --filter @dool2/relay deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dool2-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // workers.dev 주소도 켜 둔다: 그 주소로 짝지은 폰·PC가 있다. false로 배포하면 그 기기들이 모두 끊긴다(오류 1042, 2026-11-19)
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "relay.dool2.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "observability": { "enabled": true }
}
