{
  "manifest_version": 3,
  "name": "두리",
  "short_name": "두리",
  "description": "내 컴퓨터의 두리가 이 브라우저에서 대신 일할 수 있게 연결해요. 두리 PC 앱이 있어야 동작해요.",
  "version": "0.0.0",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "webNavigation",
    "alarms",
    "storage",
    "contentSettings"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "두리",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
